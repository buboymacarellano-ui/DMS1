<%- include('../partials/header') %>

<section class="dashboard-shell gm-shell gm-shell--dense gm-analytics">
  <div class="gm-analytics__head">
    <div class="dashboard-title gm-title role-dashboard-title"><span>GM</span> <span class="role-dashboard-title__suffix">Dashboard</span></div>
    <div class="gm-analytics__controls">
    <div class="gm-range-pills" id="gm-timeline-filters" aria-label="Reporting range">
      <% ['H', 'D', 'W', 'M', 'Y', 'ALL'].forEach((code) => { %>
        <button
          type="button"
          data-duration="<%= code %>"
          class="<%= activeDuration === code ? 'is-active' : '' %>"
          aria-pressed="<%= activeDuration === code ? 'true' : 'false' %>"
        ><%= code %></button>
      <% }) %>
    </div>
    <form method="get" action="/gm" class="gm-reporting-form gm-reporting-form--compact">
      <label for="gm-reporting-date">Reporting Date</label>
      <input id="gm-reporting-date" type="date" name="date" value="<%= reportingDate %>" />
      <input type="hidden" name="duration" id="gm-reporting-duration" value="<%= activeDuration %>" />
      <button type="submit" class="btn">Apply</button>
      <a
        class="gm-magic-btn"
        href="/gm/enterprise?date=<%= reportingDate %>&duration=<%= activeDuration %>"
        title="Open My Enterprises cards, buttons, and tools"
      >My Enterprises</a>
    </form>
    </div>
  </div>

  <div class="gm-analytics__grid gm-analytics__grid--overview">
    <div class="gm-analytics__kpis">
      <article class="gm-kpi-card gm-kpi-card--stack gm-kpi-card--hero" id="gm-revenue-card">
        <p class="gm-kpi-label" id="gm-revenue-label"><%= revenueLabel %></p>
        <h2 class="gm-kpi-value" id="gm-revenue-value">P <%= Number(metrics.kpis.todayRevenue || 0).toFixed(2) %></h2>
        <span class="gm-kpi-delta" id="gm-revenue-delta"><%= revenueDelta %></span>
      </article>
      <article class="gm-kpi-card gm-kpi-card--stack" id="gm-cumulative-card">
        <p class="gm-kpi-label" id="gm-cumulative-label"><%= cumulativeLabel %></p>
        <h2 class="gm-kpi-value" id="gm-cumulative-value">P <%= Number(metrics.kpis.weeklyRevenue || 0).toFixed(2) %></h2>
        <span class="gm-kpi-delta" id="gm-cumulative-delta"><%= cumulativeDelta %></span>
      </article>
      <article class="gm-kpi-card gm-kpi-card--stack" id="gm-pending-card">
        <p class="gm-kpi-label">Pending Billing</p>
        <h2 class="gm-kpi-value" id="gm-pending-count"><%= metrics.kpis.pendingBillingCount %></h2>
        <div class="gm-kpi-spark" id="gm-pending-spark" aria-hidden="true">
          <% sparkHeights.forEach((height) => { %>
            <i style="height:<%= height %>%"></i>
          <% }) %>
        </div>
      </article>
      <article class="gm-kpi-card gm-kpi-card--stack" id="gm-ticket-card">
        <p class="gm-kpi-label">Average Ticket</p>
        <h2 class="gm-kpi-value" id="gm-avg-ticket">P <%= Number(metrics.kpis.avgTicket || 0).toFixed(2) %></h2>
      </article>
    </div>

    <article class="dashboard-card gm-panel gm-analytics__card gm-analytics__ratio">
      <div class="dashboard-card__header gm-panel-header">Target Pacing Mix</div>
      <div class="gm-donut-wrap">
        <div class="gm-donut" id="gm-pacing-donut" style="--seg-a:<%= segA %>;--seg-b:<%= segB %>;--seg-c:<%= segC %>;">
          <div class="gm-donut__center">
            <strong id="gm-pacing-value"><%= Number(avgPacing || 0).toFixed(1) %>%</strong>
            <span>Avg pacing</span>
          </div>
        </div>
      </div>
    </article>

    <article class="dashboard-card gm-panel gm-analytics__card gm-analytics__perf">
      <div class="dashboard-card__header gm-panel-header">Branch Revenue Performance</div>
      <div class="gm-perf-chart" id="gm-perf-chart">
        <% if (!branchRows.length) { %>
          <p class="dashboard-note">No branch revenue yet.</p>
        <% } %>
        <% branchRows.forEach((branch) => { %>
          <%
            const revenue = Number(branch.liveAccumulatedRevenue != null ? branch.liveAccumulatedRevenue : branch.todayRevenue || 0);
            const barHeight = revenue > 0 ? Math.max(10, Math.round((revenue / maxRevenue) * 100)) : 4;
          %>
          <div class="gm-perf-col" title="<%= branch.branch %> P <%= revenue.toFixed(2) %>">
            <div class="gm-perf-col__value">P <%= revenue.toLocaleString('en-PH', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></div>
            <div class="gm-perf-col__track">
              <div class="gm-perf-col__bar" style="height:<%= barHeight %>%"></div>
            </div>
            <div class="gm-perf-col__name"><%= branch.branch || '—' %></div>
          </div>
        <% }) %>
      </div>
    </article>
  </div>
</section>

<script>
function setupTimelineFilters() {
  const pills = document.getElementById('gm-timeline-filters');
  const dateInput = document.getElementById('gm-reporting-date');
  const durationInput = document.getElementById('gm-reporting-duration');
  if (!pills) return;

  const buttons = Array.from(pills.querySelectorAll('button[data-duration]'));
  if (!buttons.length) return;

  function money(value) {
    return 'P ' + Number(value || 0).toFixed(2);
  }

  function clampPct(value) {
    return Math.max(0, Math.min(100, Number(value) || 0));
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function setActiveButton(code) {
    buttons.forEach((button) => {
      const isActive = button.getAttribute('data-duration') === code;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
    if (durationInput) durationInput.value = code;
  }

  function updateCards(payload) {
    const cards = payload && payload.cards ? payload.cards : {};
    const pacing = payload && payload.pacing ? payload.pacing : {};
    const matrix = payload && payload.matrix ? payload.matrix : { rows: [], totals: {} };

    const revenueLabelEl = document.getElementById('gm-revenue-label');
    const revenueValueEl = document.getElementById('gm-revenue-value');
    const revenueDeltaEl = document.getElementById('gm-revenue-delta');
    if (revenueLabelEl) revenueLabelEl.textContent = cards.revenueLabel || revenueLabelEl.textContent;
    if (revenueValueEl) revenueValueEl.textContent = money(cards.revenueValue);
    if (revenueDeltaEl) revenueDeltaEl.textContent = cards.revenueDelta || revenueDeltaEl.textContent;

    const cumulativeLabelEl = document.getElementById('gm-cumulative-label');
    const cumulativeValueEl = document.getElementById('gm-cumulative-value');
    const cumulativeDeltaEl = document.getElementById('gm-cumulative-delta');
    if (cumulativeLabelEl) cumulativeLabelEl.textContent = cards.cumulativeLabel || cumulativeLabelEl.textContent;
    if (cumulativeValueEl) cumulativeValueEl.textContent = money(cards.cumulativeValue);
    if (cumulativeDeltaEl) cumulativeDeltaEl.textContent = cards.cumulativeDelta || cumulativeDeltaEl.textContent;

    const pendingCountEl = document.getElementById('gm-pending-count');
    const pendingSparkEl = document.getElementById('gm-pending-spark');
    if (pendingCountEl) pendingCountEl.textContent = String(Number(cards.pendingBillingCount || 0));
    if (pendingSparkEl) {
      const heights = Array.isArray(cards.pendingSpark) && cards.pendingSpark.length
        ? cards.pendingSpark
        : [36, 52, 44, 70, 58, 82, 64];
      pendingSparkEl.innerHTML = heights.map((height) => '<i style="height:' + clampPct(height) + '%"></i>').join('');
    }

    const avgTicketEl = document.getElementById('gm-avg-ticket');
    if (avgTicketEl) avgTicketEl.textContent = money(cards.avgTicket);

    const donutEl = document.getElementById('gm-pacing-donut');
    const pacingValueEl = document.getElementById('gm-pacing-value');
    if (donutEl) {
      donutEl.style.setProperty('--seg-a', String(clampPct(pacing.segA)));
      donutEl.style.setProperty('--seg-b', String(clampPct(pacing.segB)));
      donutEl.style.setProperty('--seg-c', String(clampPct(pacing.segC)));
    }
    if (pacingValueEl) pacingValueEl.textContent = Number(pacing.avgPacing || 0).toFixed(1) + '%';

    const rows = Array.isArray(matrix.rows) ? matrix.rows : [];
    const maxRevenue = Math.max.apply(null, rows.map((row) => Number(row.liveAccumulatedRevenue || 0)).concat([1]));
    const chartEl = document.getElementById('gm-perf-chart');
    if (!chartEl) return;
    if (!rows.length) {
      chartEl.innerHTML = '<p class="dashboard-note">No branch revenue yet.</p>';
      return;
    }
    chartEl.innerHTML = rows.map((row) => {
      const revenue = Number(row.liveAccumulatedRevenue || 0);
      const barHeight = revenue > 0 ? Math.max(10, Math.round((revenue / maxRevenue) * 100)) : 4;
      const label = 'P ' + Math.round(revenue).toLocaleString('en-PH');
      return (
        '<div class="gm-perf-col" title="' + escapeHtml(row.branch || '—') + ' ' + money(revenue) + '">' +
          '<div class="gm-perf-col__value">' + label + '</div>' +
          '<div class="gm-perf-col__track"><div class="gm-perf-col__bar" style="height:' + barHeight + '%"></div></div>' +
          '<div class="gm-perf-col__name">' + escapeHtml(row.branch || '—') + '</div>' +
        '</div>'
      );
    }).join('');
  }

  async function fetchMetrics(duration) {
    const date = dateInput && dateInput.value ? dateInput.value : '';
    const params = new URLSearchParams();
    params.set('duration', duration);
    if (date) params.set('date', date);
    const response = await fetch('/api/dashboard/metrics?' + params.toString(), {
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
    });
    if (!response.ok) throw new Error('Unable to load dashboard metrics');
    return response.json();
  }

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const duration = String(button.getAttribute('data-duration') || 'D').toUpperCase();
      setActiveButton(duration);
      buttons.forEach((item) => { item.disabled = true; });
      try {
        updateCards(await fetchMetrics(duration));
      } catch (error) {
        console.error(error);
      } finally {
        buttons.forEach((item) => { item.disabled = false; });
      }
    });
  });

  async function refreshLiveMetrics() {
    if (document.visibilityState === 'hidden') return;
    const duration = durationInput && durationInput.value
      ? String(durationInput.value).toUpperCase()
      : 'D';
    try {
      updateCards(await fetchMetrics(duration));
    } catch (error) {
      console.error(error);
    }
  }

  setInterval(refreshLiveMetrics, 12000);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', setupTimelineFilters);
} else {
  setupTimelineFilters();
}
</script>
<%- include('../partials/footer') %>
