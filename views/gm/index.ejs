<%- include('../partials/header') %>
<%
  const allBranchRows = Array.isArray(metrics.branchMilestones) ? metrics.branchMilestones : [];
  const branchRows = allBranchRows.filter((row) => !row.isPipeline && String(row.branch || '').trim().toLowerCase() !== 'proposed location');
  const matrixTotals = branchRows.reduce((acc, row) => {
    const open = Number(row.openWorkOrders || 0);
    const revenue = Number(row.liveAccumulatedRevenue != null ? row.liveAccumulatedRevenue : row.todayRevenue || 0);
    const pacing = Number(row.targetPacingPct != null ? row.targetPacingPct : row.milestonePercent || 0);
    const laborGm = Number(row.laborGrossMarginPct || 0);
    const partsGm = Number(row.partsGrossMarginPct || 0);
    acc.openWorkOrders += open;
    acc.liveAccumulatedRevenue += revenue;
    acc.targetPacingPct += pacing;
    acc.laborGrossMarginPct += laborGm;
    acc.partsGrossMarginPct += partsGm;
    return acc;
  }, {
    openWorkOrders: 0,
    liveAccumulatedRevenue: 0,
    targetPacingPct: 0,
    laborGrossMarginPct: 0,
    partsGrossMarginPct: 0,
  });
  const branchCount = branchRows.length || 1;
  const avgPacing = matrixTotals.targetPacingPct / branchCount;
  const avgLabor = matrixTotals.laborGrossMarginPct / branchCount;
  const avgParts = matrixTotals.partsGrossMarginPct / branchCount;
  const clampPct = (value) => Math.max(0, Math.min(100, Number(value) || 0));
  const segA = clampPct(avgLabor * 0.45);
  const segB = clampPct(segA + avgParts * 0.35);
  const segC = clampPct(segB + avgPacing * 0.35);
  const maxRevenue = Math.max.apply(null, branchRows.map((row) => Number(row.liveAccumulatedRevenue != null ? row.liveAccumulatedRevenue : row.todayRevenue || 0)).concat([1]));
  const maxOpenWorkOrders = Math.max.apply(null, branchRows.map((row) => Number(row.openWorkOrders || 0)).concat([1]));
  const statusCounts = branchRows.reduce((acc, row) => {
    const code = String(row.statusWarningCode || 'ok').toLowerCase();
    if (code === 'alert') acc.alert += 1;
    else if (code === 'watch') acc.watch += 1;
    else acc.ok += 1;
    return acc;
  }, { ok: 0, watch: 0, alert: 0 });
  const activeDuration = String(metrics.duration || metrics.reporting.duration || 'D').toUpperCase();
  const sparkHeights = Array.isArray(metrics.kpis.pendingSpark) && metrics.kpis.pendingSpark.length
    ? metrics.kpis.pendingSpark
    : [36, 52, 44, 70, 58, 82, 64];
  const revenueLabel = metrics.reporting.revenueLabel || ('Revenue on ' + metrics.reporting.label);
  const revenueDelta = metrics.reporting.revenueDelta || '▲ Daily close';
  const cumulativeLabel = metrics.reporting.cumulativeLabel || ('Week Through ' + metrics.reporting.label);
  const cumulativeDelta = metrics.reporting.cumulativeDelta || '▲ Week to date';
  const fadeRight = (weight) =>
    `background-image:linear-gradient(to right, rgba(78, 205, 232, 0.38), rgba(78, 205, 232, 0)) !important;background-size:${weight}% 100% !important;background-repeat:no-repeat !important;background-position:left center !important;`;
  const fadeLeft = (weight) =>
    `background-image:linear-gradient(to left, rgba(184, 230, 76, 0.34), rgba(184, 230, 76, 0)) !important;background-size:${weight}% 100% !important;background-repeat:no-repeat !important;background-position:right center !important;`;
%>

<section class="dashboard-shell gm-shell gm-shell--dense gm-analytics">
  <div class="gm-analytics__head">
    <div class="dashboard-title gm-title role-dashboard-title"><span>GM</span> <span class="role-dashboard-title__suffix">Dashboard</span></div>
    <div class="gm-analytics__controls">
    <div class="gm-range-pills" id="gm-timeline-filters" aria-label="Reporting range">
      <% ['H', 'D', 'W', 'M', 'Y', 'ALL'].forEach((code) => { %>
        <button
          type="button"
          data-duration="<%= code %>"
          class="<%= activeDuration === code ? 'is-active' : '' %>"
          aria-pressed="<%= activeDuration === code ? 'true' : 'false' %>"
        ><%= code %></button>
      <% }) %>
    </div>
    <form method="get" action="/gm" class="gm-reporting-form gm-reporting-form--compact">
      <label for="gm-reporting-date">Reporting Date</label>
      <input id="gm-reporting-date" type="date" name="date" value="<%= metrics.reporting.date %>" />
      <input type="hidden" name="duration" id="gm-reporting-duration" value="<%= activeDuration %>" />
      <button type="submit" class="btn">Apply</button>
      <button type="button" class="btn gm-dense-link" id="btnToggleTargets" onclick="toggleTargetPanel()">Targets</button>
      <a class="btn gm-dense-link" href="/gm/performance-incentives?date=<%= metrics.reporting.date %>">Incentives</a>
      <a class="btn gm-dense-link" href="/gm/catalog" title="DEMO DMS DX Catalog">Catalog</a>
      <a class="btn gm-dense-link" href="/gm/fte" title="Facility, Tool &amp; Equipment Tracking Panel">FTE</a>
    </form>
    </div>
  </div>

  <% const branchSalesTargets = metrics.branchSalesTargets || { monthLabel: 'August 2026', branches: {} }; %>
  <div id="targetConfigPanel" class="bg-slate-900 border border-blue-500/30 p-4 rounded-lg mb-6 gm-target-panel<%= typeof targetsSaved !== 'undefined' && targetsSaved ? '' : ' hidden' %>">
    <div class="flex justify-between items-center mb-4 gm-target-panel__head">
      <h4 class="text-md font-bold text-orange-400">⚙️ Set Branch Gross Sales Targets for <%= branchSalesTargets.monthLabel || 'August 2026' %></h4>
      <button type="button" onclick="toggleTargetPanel()" class="text-gray-400 hover:text-white gm-target-panel__close" aria-label="Close target panel">✕</button>
    </div>
    <% if (typeof targetsSaved !== 'undefined' && targetsSaved) { %>
      <p class="dashboard-note">Targets saved. Dashboard pacing now uses the new monthly peso goals.</p>
    <% } %>
    <form id="targetForm" method="post" action="/gm/branch-targets" class="grid grid-cols-1 md:grid-cols-4 gap-4 gm-target-form">
      <input type="hidden" name="date" value="<%= metrics.reporting.date %>" />
      <input type="hidden" name="duration" id="gm-target-duration" value="<%= activeDuration %>" />
      <% ['Carx2', 'Carmen', 'CebuCity', 'Lapux2', 'Bogo', 'Toledo', 'ITPark'].forEach((branchName) => { %>
        <div>
          <label class="block text-xs font-medium text-gray-300"><%= branchName %> Target (₱)</label>
          <input
            type="number"
            name="<%= branchName %>"
            min="0"
            step="1000"
            value="<%= Number((branchSalesTargets.branches && branchSalesTargets.branches[branchName]) || 0) %>"
            class="w-full bg-slate-800 border border-gray-600 rounded p-1.5 text-white text-sm"
          />
        </div>
      <% }) %>
      <div class="md:col-span-4 flex justify-end mt-2 gm-target-form__actions">
        <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded shadow">
          💾 Save & Recalculate Dashboard
        </button>
      </div>
    </form>
  </div>

  <div class="gm-analytics__grid">
    <div class="gm-analytics__kpis">
      <article class="gm-kpi-card gm-kpi-card--stack gm-kpi-card--hero" id="gm-revenue-card">
        <p class="gm-kpi-label" id="gm-revenue-label"><%= revenueLabel %></p>
        <h2 class="gm-kpi-value" id="gm-revenue-value">P <%= Number(metrics.kpis.todayRevenue || 0).toFixed(2) %></h2>
        <span class="gm-kpi-delta" id="gm-revenue-delta"><%= revenueDelta %></span>
      </article>
      <article class="gm-kpi-card gm-kpi-card--stack" id="gm-cumulative-card">
        <p class="gm-kpi-label" id="gm-cumulative-label"><%= cumulativeLabel %></p>
        <h2 class="gm-kpi-value" id="gm-cumulative-value">P <%= Number(metrics.kpis.weeklyRevenue || 0).toFixed(2) %></h2>
        <span class="gm-kpi-delta" id="gm-cumulative-delta"><%= cumulativeDelta %></span>
      </article>
      <article class="gm-kpi-card gm-kpi-card--stack" id="gm-pending-card">
        <p class="gm-kpi-label">Pending Billing</p>
        <h2 class="gm-kpi-value" id="gm-pending-count"><%= metrics.kpis.pendingBillingCount %></h2>
        <div class="gm-kpi-spark" id="gm-pending-spark" aria-hidden="true">
          <% sparkHeights.forEach((height) => { %>
            <i style="height:<%= height %>%"></i>
          <% }) %>
        </div>
      </article>
      <article class="gm-kpi-card gm-kpi-card--stack" id="gm-ticket-card">
        <p class="gm-kpi-label">Average Ticket</p>
        <h2 class="gm-kpi-value" id="gm-avg-ticket">P <%= Number(metrics.kpis.avgTicket || 0).toFixed(2) %></h2>
      </article>
    </div>

    <article class="dashboard-card gm-panel gm-analytics__card gm-analytics__ratio">
      <div class="dashboard-card__header gm-panel-header">Target Pacing Mix</div>
      <div class="gm-donut-wrap">
        <div class="gm-donut" id="gm-pacing-donut" style="--seg-a:<%= segA %>;--seg-b:<%= segB %>;--seg-c:<%= segC %>;">
          <div class="gm-donut__center">
            <strong id="gm-pacing-value"><%= avgPacing.toFixed(1) %>%</strong>
            <span>Avg pacing</span>
          </div>
        </div>
      </div>
    </article>

    <article class="dashboard-card gm-panel gm-analytics__card gm-analytics__perf">
      <div class="dashboard-card__header gm-panel-header">Branch Revenue Performance</div>
      <div class="gm-perf-chart" id="gm-perf-chart">
        <% if (!branchRows.length) { %>
          <p class="dashboard-note">No branch revenue yet.</p>
        <% } %>
        <% branchRows.forEach((branch) => { %>
          <%
            const revenue = Number(branch.liveAccumulatedRevenue != null ? branch.liveAccumulatedRevenue : branch.todayRevenue || 0);
            const barHeight = revenue > 0 ? Math.max(10, Math.round((revenue / maxRevenue) * 100)) : 4;
          %>
          <div class="gm-perf-col" title="<%= branch.branch %> P <%= revenue.toFixed(2) %>">
            <div class="gm-perf-col__value">P <%= revenue.toLocaleString('en-PH', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></div>
            <div class="gm-perf-col__track">
              <div class="gm-perf-col__bar" style="height:<%= barHeight %>%"></div>
            </div>
            <div class="gm-perf-col__name"><%= branch.branch || '—' %></div>
          </div>
        <% }) %>
      </div>
    </article>

    <article class="dashboard-card gm-panel gm-matrix-panel gm-analytics__card gm-analytics__matrix">
      <div class="dashboard-card__header gm-panel-header">Multi-Branch Data Matrix</div>
      <div class="gm-matrix-wrap">
        <table class="list gm-table gm-matrix-table">
          <thead>
            <tr>
              <th>Branch Name</th>
              <th>Open Work Orders</th>
              <th>Live Accumulated Revenue</th>
              <th>Target Pacing %</th>
              <th>Labor Gross Margin %</th>
              <th>Parts Gross Margin %</th>
              <th>Status Warning</th>
            </tr>
          </thead>
          <tbody id="gm-matrix-body">
            <% if (!branchRows.length) { %>
              <tr><td colspan="7" style="text-align:center;">No branch records available.</td></tr>
            <% } %>
            <% branchRows.forEach((branch) => { %>
              <%
                const openWorkOrders = Number(branch.openWorkOrders != null ? branch.openWorkOrders : 0);
                const pacing = Number(branch.targetPacingPct != null ? branch.targetPacingPct : branch.milestonePercent || 0);
                const laborGm = Number(branch.laborGrossMarginPct || 0);
                const partsGm = Number(branch.partsGrossMarginPct || 0);
              %>
              <tr>
                <td><%= branch.branch || '—' %></td>
                <td style="<%= fadeRight(clampPct((openWorkOrders / maxOpenWorkOrders) * 100)) %>"><%= openWorkOrders %></td>
                <td>P <%= Number(branch.liveAccumulatedRevenue || branch.todayRevenue || 0).toFixed(2) %></td>
                <td style="<%= fadeRight(clampPct(pacing)) %>">
                  <span style="display:inline-flex;align-items:center;justify-content:center;background:#b8e64c;color:#10243d;border-radius:999px;padding:2px 8px;font-weight:700;font-size:11px;line-height:1.2;">
                    <%= pacing.toFixed(1) %>%
                  </span>
                </td>
                <td style="<%= fadeLeft(clampPct(laborGm)) %>"><%= laborGm.toFixed(1) %>%</td>
                <td style="<%= fadeLeft(clampPct(partsGm)) %>"><%= partsGm.toFixed(1) %>%</td>
                <td>
                  <span class="gm-status-flag gm-status-flag--<%= branch.statusWarningCode || 'ok' %>">
                    <%= branch.statusWarning || 'OK' %>
                  </span>
                </td>
              </tr>
            <% }) %>
            <% if (branchRows.length) { %>
              <tr class="gm-matrix-row--total">
                <td>Total</td>
                <td><%= matrixTotals.openWorkOrders %></td>
                <td>P <%= Number(matrixTotals.liveAccumulatedRevenue).toFixed(2) %></td>
                <td><%= (matrixTotals.targetPacingPct / branchCount).toFixed(1) %>%</td>
                <td><%= (matrixTotals.laborGrossMarginPct / branchCount).toFixed(1) %>%</td>
                <td><%= (matrixTotals.partsGrossMarginPct / branchCount).toFixed(1) %>%</td>
                <td><span class="gm-status-flag gm-status-flag--ok">TOTAL</span></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </article>

    <article class="dashboard-card gm-panel gm-matrix-panel gm-analytics__card gm-analytics__status gm-ocpd-panel">
      <div class="dashboard-card__header gm-panel-header gm-ocpd-header">
        <span>OCPD Reporting</span>
        <div class="gm-ocpd-nav" role="group" aria-label="OCPD report date">
          <button type="button" id="gm-ocpd-prev" aria-label="Previous day">&lt;</button>
          <strong id="gm-ocpd-date-label"><%= ocpdReport.dateLabel %></strong>
          <button type="button" id="gm-ocpd-next" aria-label="Next day" <%= ocpdReport.canGoNext ? '' : 'disabled' %>>&gt;</button>
        </div>
      </div>
      <div class="gm-ocpd-wrap">
        <table class="list gm-table gm-matrix-table gm-ocpd-table">
          <thead>
            <tr>
              <% ocpdReport.columns.forEach((column) => { %>
                <th><%= column.header %></th>
              <% }) %>
            </tr>
          </thead>
          <tbody id="gm-ocpd-body" data-date="<%= ocpdReport.date %>" data-today="<%= ocpdReport.today %>">
            <% ocpdReport.rows.forEach((row) => { %>
              <tr>
                <% ocpdReport.columns.forEach((column) => { %>
                  <td><%= column.key === 'date' ? ocpdReport.dateLabel : (row[column.key] == null ? '0' : row[column.key]) %></td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </article>

    <div class="gm-action-grid gm-analytics__actions">
      <article class="dashboard-card gm-panel gm-action-panel">
        <div class="dashboard-card__header gm-panel-header">Risk Alerts (Open > 24 Hours)</div>
        <% if (!metrics.riskAlerts.length) { %>
          <p class="dashboard-note">No high-age work order alerts right now.</p>
        <% } else { %>
          <div class="gm-action-feed" aria-label="Risk alerts feed">
            <% metrics.riskAlerts.forEach((entry) => { %>
              <div class="gm-action-feed__item gm-action-feed__item--risk">
                <strong>WO <%= entry.work_order_number %></strong>
                <span><%= entry.status || 'open' %></span>
                <em><%= entry.ageHours %>h</em>
              </div>
            <% }) %>
          </div>
        <% } %>
      </article>

      <article class="dashboard-card gm-panel gm-action-panel">
        <div class="dashboard-card__header gm-panel-header">Top Services (Revenue)</div>
        <% if (!metrics.topServices.length) { %>
          <p class="dashboard-note">No service revenue data yet.</p>
        <% } else { %>
          <div class="gm-action-feed gm-action-feed--table">
            <table class="list gm-table gm-action-table">
              <thead>
                <tr>
                  <th>Service</th>
                  <th>Count</th>
                  <th>Revenue</th>
                </tr>
              </thead>
              <tbody>
                <% metrics.topServices.forEach((entry) => { %>
                  <tr>
                    <td><%= entry.service %></td>
                    <td><%= entry.count %></td>
                    <td>P <%= Number(entry.revenue || 0).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </article>

      <article class="dashboard-card gm-panel gm-action-panel">
        <div class="dashboard-card__header gm-panel-header">Top Technicians (Closed Revenue)</div>
        <% if (!metrics.topTechnicians.length) { %>
          <p class="dashboard-note">No technician performance data yet.</p>
        <% } else { %>
          <div class="gm-action-feed gm-action-feed--table">
            <table class="list gm-table gm-action-table">
              <thead>
                <tr>
                  <th>Technician</th>
                  <th>Closed</th>
                  <th>Revenue</th>
                </tr>
              </thead>
              <tbody>
                <% metrics.topTechnicians.forEach((entry) => { %>
                  <tr>
                    <td><%= entry.technician %></td>
                    <td><%= entry.closedCount %></td>
                    <td>P <%= Number(entry.revenue || 0).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </article>
    </div>
  </div>
</section>

<script>
function toggleTargetPanel() {
  const panel = document.getElementById('targetConfigPanel');
  if (!panel) return;
  panel.classList.toggle('hidden');
}

function setupTimelineFilters() {
  const pills = document.getElementById('gm-timeline-filters');
  const dateInput = document.getElementById('gm-reporting-date');
  const durationInput = document.getElementById('gm-reporting-duration');
  if (!pills) return;

  const buttons = Array.from(pills.querySelectorAll('button[data-duration]'));
  if (!buttons.length) return;

  function money(value) {
    return 'P ' + Number(value || 0).toFixed(2);
  }

  function clampPct(value) {
    return Math.max(0, Math.min(100, Number(value) || 0));
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function fadeRight(weight) {
    return 'background-image:linear-gradient(to right, rgba(78, 205, 232, 0.38), rgba(78, 205, 232, 0)) !important;background-size:' + clampPct(weight) + '% 100% !important;background-repeat:no-repeat !important;background-position:left center !important;';
  }

  function fadeLeft(weight) {
    return 'background-image:linear-gradient(to left, rgba(184, 230, 76, 0.34), rgba(184, 230, 76, 0)) !important;background-size:' + clampPct(weight) + '% 100% !important;background-repeat:no-repeat !important;background-position:right center !important;';
  }

  function setActiveButton(code) {
    buttons.forEach((button) => {
      const isActive = button.getAttribute('data-duration') === code;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
    if (durationInput) durationInput.value = code;
    const targetDuration = document.getElementById('gm-target-duration');
    if (targetDuration) targetDuration.value = code;
  }

  function updateCards(payload) {
    const cards = payload && payload.cards ? payload.cards : {};
    const pacing = payload && payload.pacing ? payload.pacing : {};
    const matrix = payload && payload.matrix ? payload.matrix : { rows: [], totals: {} };

    const revenueLabelEl = document.getElementById('gm-revenue-label');
    const revenueValueEl = document.getElementById('gm-revenue-value');
    const revenueDeltaEl = document.getElementById('gm-revenue-delta');
    if (revenueLabelEl) revenueLabelEl.textContent = cards.revenueLabel || revenueLabelEl.textContent;
    if (revenueValueEl) revenueValueEl.textContent = money(cards.revenueValue);
    if (revenueDeltaEl) revenueDeltaEl.textContent = cards.revenueDelta || revenueDeltaEl.textContent;

    const cumulativeLabelEl = document.getElementById('gm-cumulative-label');
    const cumulativeValueEl = document.getElementById('gm-cumulative-value');
    const cumulativeDeltaEl = document.getElementById('gm-cumulative-delta');
    if (cumulativeLabelEl) cumulativeLabelEl.textContent = cards.cumulativeLabel || cumulativeLabelEl.textContent;
    if (cumulativeValueEl) cumulativeValueEl.textContent = money(cards.cumulativeValue);
    if (cumulativeDeltaEl) cumulativeDeltaEl.textContent = cards.cumulativeDelta || cumulativeDeltaEl.textContent;

    const pendingCountEl = document.getElementById('gm-pending-count');
    const pendingSparkEl = document.getElementById('gm-pending-spark');
    if (pendingCountEl) pendingCountEl.textContent = String(Number(cards.pendingBillingCount || 0));
    if (pendingSparkEl) {
      const heights = Array.isArray(cards.pendingSpark) && cards.pendingSpark.length
        ? cards.pendingSpark
        : [36, 52, 44, 70, 58, 82, 64];
      pendingSparkEl.innerHTML = heights.map((height) => '<i style="height:' + clampPct(height) + '%"></i>').join('');
    }

    const avgTicketEl = document.getElementById('gm-avg-ticket');
    if (avgTicketEl) avgTicketEl.textContent = money(cards.avgTicket);

    const donutEl = document.getElementById('gm-pacing-donut');
    const pacingValueEl = document.getElementById('gm-pacing-value');
    if (donutEl) {
      donutEl.style.setProperty('--seg-a', String(clampPct(pacing.segA)));
      donutEl.style.setProperty('--seg-b', String(clampPct(pacing.segB)));
      donutEl.style.setProperty('--seg-c', String(clampPct(pacing.segC)));
    }
    if (pacingValueEl) pacingValueEl.textContent = Number(pacing.avgPacing || 0).toFixed(1) + '%';

    const rows = Array.isArray(matrix.rows) ? matrix.rows : [];
    const totals = matrix.totals || {};
    const branchCount = rows.length || 1;
    const maxRevenue = Math.max.apply(null, rows.map((row) => Number(row.liveAccumulatedRevenue || 0)).concat([1]));
    const maxOpen = Math.max.apply(null, rows.map((row) => Number(row.openWorkOrders || 0)).concat([1]));

    const chartEl = document.getElementById('gm-perf-chart');
    if (chartEl) {
      if (!rows.length) {
        chartEl.innerHTML = '<p class="dashboard-note">No branch revenue yet.</p>';
      } else {
        chartEl.innerHTML = rows.map((row) => {
          const revenue = Number(row.liveAccumulatedRevenue || 0);
          const barHeight = revenue > 0 ? Math.max(10, Math.round((revenue / maxRevenue) * 100)) : 4;
          const label = 'P ' + Math.round(revenue).toLocaleString('en-PH');
          return (
            '<div class="gm-perf-col" title="' + escapeHtml(row.branch || '—') + ' ' + money(revenue) + '">' +
              '<div class="gm-perf-col__value">' + label + '</div>' +
              '<div class="gm-perf-col__track"><div class="gm-perf-col__bar" style="height:' + barHeight + '%"></div></div>' +
              '<div class="gm-perf-col__name">' + escapeHtml(row.branch || '—') + '</div>' +
            '</div>'
          );
        }).join('');
      }
    }

    const matrixBody = document.getElementById('gm-matrix-body');
    if (!matrixBody) return;
    if (!rows.length) {
      matrixBody.innerHTML = '<tr><td colspan="7" style="text-align:center;">No branch records available.</td></tr>';
      return;
    }

    const rowHtml = rows.map((row) => {
      const openWorkOrders = Number(row.openWorkOrders || 0);
      const pacingPct = Number(row.targetPacingPct || 0);
      const laborGm = Number(row.laborGrossMarginPct || 0);
      const partsGm = Number(row.partsGrossMarginPct || 0);
      const statusCode = /^(ok|watch|alert)$/i.test(String(row.statusWarningCode || ''))
        ? String(row.statusWarningCode).toLowerCase()
        : 'ok';
      return (
        '<tr>' +
          '<td>' + escapeHtml(row.branch || '—') + '</td>' +
          '<td style="' + fadeRight((openWorkOrders / maxOpen) * 100) + '">' + openWorkOrders + '</td>' +
          '<td>' + money(row.liveAccumulatedRevenue) + '</td>' +
          '<td style="' + fadeRight(pacingPct) + '">' +
            '<span style="display:inline-flex;align-items:center;justify-content:center;background:#b8e64c;color:#10243d;border-radius:999px;padding:2px 8px;font-weight:700;font-size:11px;line-height:1.2;">' +
              pacingPct.toFixed(1) + '%' +
            '</span>' +
          '</td>' +
          '<td style="' + fadeLeft(laborGm) + '">' + laborGm.toFixed(1) + '%</td>' +
          '<td style="' + fadeLeft(partsGm) + '">' + partsGm.toFixed(1) + '%</td>' +
          '<td><span class="gm-status-flag gm-status-flag--' + statusCode + '">' + escapeHtml(row.statusWarning || 'OK') + '</span></td>' +
        '</tr>'
      );
    }).join('');

    const totalHtml =
      '<tr class="gm-matrix-row--total">' +
        '<td>Total</td>' +
        '<td>' + Number(totals.openWorkOrders || 0) + '</td>' +
        '<td>' + money(totals.liveAccumulatedRevenue) + '</td>' +
        '<td>' + (Number(totals.targetPacingPct || 0) / branchCount).toFixed(1) + '%</td>' +
        '<td>' + (Number(totals.laborGrossMarginPct || 0) / branchCount).toFixed(1) + '%</td>' +
        '<td>' + (Number(totals.partsGrossMarginPct || 0) / branchCount).toFixed(1) + '%</td>' +
        '<td><span class="gm-status-flag gm-status-flag--ok">TOTAL</span></td>' +
      '</tr>';

    matrixBody.innerHTML = rowHtml + totalHtml;
  }

  async function fetchMetrics(duration) {
    const date = dateInput && dateInput.value ? dateInput.value : '';
    const params = new URLSearchParams();
    params.set('duration', duration);
    if (date) params.set('date', date);
    const response = await fetch('/api/dashboard/metrics?' + params.toString(), {
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
    });
    if (!response.ok) {
      throw new Error('Unable to load dashboard metrics');
    }
    return response.json();
  }

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const duration = String(button.getAttribute('data-duration') || 'D').toUpperCase();
      setActiveButton(duration);
      buttons.forEach((item) => { item.disabled = true; });
      try {
        const payload = await fetchMetrics(duration);
        updateCards(payload);
      } catch (error) {
        console.error(error);
      } finally {
        buttons.forEach((item) => { item.disabled = false; });
      }
    });
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    setupTimelineFilters();
    setupOcpdDateNav();
  });
} else {
  setupTimelineFilters();
  setupOcpdDateNav();
}

function setupOcpdDateNav() {
  const body = document.getElementById('gm-ocpd-body');
  const label = document.getElementById('gm-ocpd-date-label');
  const prev = document.getElementById('gm-ocpd-prev');
  const next = document.getElementById('gm-ocpd-next');
  if (!body || !label || !prev || !next) return;

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderReport(report) {
    if (!report || !Array.isArray(report.rows)) return;
    body.setAttribute('data-date', report.date || '');
    body.setAttribute('data-today', report.today || '');
    label.textContent = report.dateLabel || report.date || '';
    next.disabled = !report.canGoNext;
    const columns = Array.isArray(report.columns) ? report.columns : [];
    body.innerHTML = report.rows.map((row) => {
      const cells = columns.map((column) => {
        const key = column && column.key;
        const value = key === 'date' ? (report.dateLabel || row.date || '') : (row[key] == null ? 0 : row[key]);
        return '<td>' + escapeHtml(value) + '</td>';
      }).join('');
      return '<tr>' + cells + '</tr>';
    }).join('');
  }

  async function loadDate(date) {
    prev.disabled = true;
    next.disabled = true;
    try {
      const params = new URLSearchParams();
      if (date) params.set('date', date);
      const response = await fetch('/api/gm/ocpd?' + params.toString(), {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      });
      if (!response.ok) throw new Error('Unable to load OCPD reporting');
      renderReport(await response.json());
    } catch (error) {
      console.error(error);
      next.disabled = String(body.getAttribute('data-date') || '') >= String(body.getAttribute('data-today') || '');
    } finally {
      prev.disabled = false;
    }
  }

  prev.addEventListener('click', () => {
    const current = body.getAttribute('data-date');
    if (!current) return;
    const [year, month, day] = current.split('-').map(Number);
    const previous = new Date(Date.UTC(year, month - 1, day - 1));
    const nextDate = previous.toISOString().slice(0, 10);
    loadDate(nextDate);
  });

  next.addEventListener('click', () => {
    const current = body.getAttribute('data-date');
    const today = body.getAttribute('data-today');
    if (!current || current >= today) return;
    const [year, month, day] = current.split('-').map(Number);
    const following = new Date(Date.UTC(year, month - 1, day + 1));
    loadDate(following.toISOString().slice(0, 10));
  });
}
</script>
