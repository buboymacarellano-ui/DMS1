<%- include('../partials/header') %>

<section class="dashboard-shell admin-shell">
  <style>
    .parts-scope-cards {
      gap: 16px;
    }

    .parts-scope-cards .pm-panel {
      min-height: 75px;
      padding: 12px 16px;
      border: 1px solid #b7c8d8;
      border-radius: 12px;
      background: linear-gradient(145deg, #ffffff, #edf4fa);
      box-shadow: none;
      color: #12324d;
    }

    .parts-scope-cards .parts-scope-card--active {
      border-color: #2f78ad;
      background: linear-gradient(145deg, #2f78ad, #123b63);
      color: #fff;
      box-shadow: none;
    }

    .parts-scope-cards .pm-panel-header {
      padding: 0 0 12px;
      background: transparent;
      border: 0;
      color: inherit;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .parts-scope-cards .admin-note {
      color: inherit;
      opacity: 0.82;
    }

    .parts-scope-cards .btn {
      margin-top: 8px;
      background: #0e7490 !important;
      border-color: #155e75 !important;
      color: #fff !important;
      box-shadow: 0 4px 10px rgba(9, 47, 70, 0.2);
    }

    #parts-records table thead th {
      background: linear-gradient(180deg, #2f78ad, #1b4f72) !important;
      border-color: #8ec8f0 !important;
      color: #fff !important;
      font-size: 12px !important;
      font-weight: 800 !important;
      line-height: 1.1 !important;
      padding: 10px 14px !important;
      text-transform: uppercase;
      white-space: nowrap !important;
    }
  </style>
  <% const view = typeof partsView !== 'undefined' && partsView ? partsView : { isFrontline: false, scope: 'all', readOnly: false, label: 'Parts Database', location: '' }; %>
  <% if (view.isFrontline) { %>
    <div style="margin-bottom:14px;">
      <%- include('../partials/db-health-card', { stockUrl: '/parts/api/stock-health' + (view.scope === 'warehouse1' ? '?scope=warehouse1' : '') }) %>
    </div>
  <% } %>
  <% if (error) { %><p class="error" style="font-weight:700;margin-bottom:10px;"><%= error %></p><% } %>
  <% if (success) { %><p class="success" style="font-weight:700;margin-bottom:10px;"><%= success %></p><% } %>

  <% if (view.isFrontline) { %>
    <p class="dashboard-note admin-note">
      Default view is <strong>your branch only</strong>. Open the Warehouse 1 card to look up warehouse stock without changing your branch records.
    </p>
    <div class="pm-grid parts-scope-cards" style="margin-bottom:14px;">
      <article class="dashboard-card admin-panel pm-panel<%= view.scope === 'branch' ? ' parts-scope-card--active' : '' %>">
        <div class="dashboard-card__header admin-panel-header pm-panel-header">
          <span><%= actorBranch || 'Branch' %> Parts Database</span>
          <% if (view.scope === 'branch') { %><span class="pm-badge">Default</span><% } %>
        </div>
        <p class="dashboard-note admin-note">Only parts and transactions for <%= actorBranch || 'your assigned branch' %>.</p>
        <a class="btn" href="/parts" style="background:#1a6bbf;">View branch database</a>
      </article>
      <article class="dashboard-card admin-panel pm-panel<%= view.scope === 'warehouse1' ? ' parts-scope-card--active' : '' %>">
        <div class="dashboard-card__header admin-panel-header pm-panel-header">
          <span>Warehouse 1</span>
          <% if (view.scope === 'warehouse1') { %><span class="pm-badge">Viewing</span><% } %>
        </div>
        <p class="dashboard-note admin-note">Read-only Warehouse 1 parts database and transactions.</p>
        <a class="btn" href="/parts?scope=warehouse1" style="background:#0f6d8c;">View Warehouse 1</a>
      </article>
    </div>
  <% } %>

  <%- include('../partials/parts-report-modal') %>

  <form method="get" action="/parts" class="form" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:14px;">
    <% if (view.scope === 'warehouse1') { %><input type="hidden" name="scope" value="warehouse1" /><% } %>
    <label style="margin:0;">Search
      <input name="q" value="<%= q %>" placeholder="Part #, name, Sub-ID, supplier, work order..." style="min-width:220px;" />
    </label>
    <label style="margin:0;">Type
      <select name="type">
        <option value="">All Types</option>
        <% transactionTypes.forEach(t => { %>
            <option value="<%= t %>" <%= (typeof normalizePartsTransactionType === 'function' ? normalizePartsTransactionType(filterType) : filterType) === t ? 'selected' : '' %>><%= displayPartsTransactionType(t) %></option>
        <% }) %>
      </select>
    </label>
    <button type="submit">Filter</button>
    <a class="btn" href="<%= view.scope === 'warehouse1' ? '/parts?scope=warehouse1' : '/parts' %>">Clear</a>
    <% if (!view.readOnly) { %>
    <a class="btn" href="/parts/new" style="background:#1a6bbf;">+ New Entry</a>
    <a class="btn" href="#parts-records" style="background:#1f8f53;">EditParts</a>
    <% } %>
    <button type="button" class="btn report-export__btn" id="parts-report-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="parts-report-modal">Create Report</button>
    <span class="dashboard-note admin-note" style="margin:0;align-self:center;">Visible records: <strong><%= total %></strong> Â· Depleted New / Stock rows hide from this table after 3 working days but stay in History</span>
  </form>

  <div id="parts-records" class="table-scroll" style="overflow-x:auto;max-height:72vh;overflow-y:auto;">
    <table class="list" style="min-width:max-content;font-size:12px;">
      <thead style="position:sticky;top:0;z-index:5;">
        <tr>
          <th>#</th>
          <th style="white-space:nowrap;">Date</th>
          <th style="white-space:nowrap;">Type</th>
          <th style="white-space:nowrap;">Location</th>
          <th style="white-space:nowrap;">Editor</th>
          <th style="white-space:nowrap;">PN</th>
          <th style="white-space:nowrap;">PName</th>
          <th style="white-space:nowrap;">Sub-ID</th>
          <th style="white-space:nowrap;">Generic</th>
          <th style="white-space:nowrap;">Supplier</th>
          <th style="white-space:nowrap;">Qty</th>
          <th style="white-space:nowrap;">On-Hand</th>
          <th style="white-space:nowrap;">Cost Price</th>
          <th style="white-space:nowrap;">Markup (%)</th>
          <th style="white-space:nowrap;">Retail Price</th>
          <th style="white-space:nowrap;">Sold To</th>
          <th style="white-space:nowrap;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!parts.length) { %>
          <tr><td colspan="17" style="text-align:center;padding:20px;">No records found.</td></tr>
        <% } %>
        <% parts.forEach((p, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td style="white-space:nowrap;"><%= p.transaction_date || '' %></td>
            <td style="white-space:nowrap;">
              <span style="font-weight:700;">
                <%= displayPartsTransactionType(p.transaction_type) %>
              </span>
            </td>
            <td style="white-space:nowrap;">
              <%= p.present_location || p.branch || p.requesting_branch || '' %>
            </td>
            <td style="white-space:nowrap;"><%= p.editor || '' %></td>
            <td style="white-space:nowrap;"><%= p.part_number || '' %></td>
            <td style="white-space:nowrap;"><%= p.part_name || '' %></td>
            <td style="white-space:nowrap;"><%= p.sub_id || '' %></td>
            <td style="white-space:nowrap;"><%= p.generic || '' %></td>
            <td style="white-space:nowrap;"><%= p.supplier || '' %></td>
            <td style="text-align:right;"><%= p.qty != null ? p.qty : '' %></td>
            <td style="text-align:right;"><%= p.on_hand != null ? p.on_hand : '' %></td>
            <td style="text-align:right;"><%= p.cost_price != null ? Number(p.cost_price).toFixed(2) : '' %></td>
            <td style="text-align:right;"><%= p.markup != null ? p.markup : '' %></td>
            <td style="text-align:right;"><%= p.retail_price != null ? Number(p.retail_price).toFixed(2) : '' %></td>
            <td style="white-space:nowrap;"><%= p.sold_to || '' %></td>
              <td style="white-space:nowrap;">
                <a class="btn" href="/parts/history/<%= encodeURIComponent(p.part_number || '') %><%= view.scope === 'warehouse1' ? '?scope=warehouse1' : '' %>" style="font-size:11px;padding:4px 8px;">History</a>
                <% if (!view.readOnly) { %>
                  <% if (typeof isSoldTransaction === 'function' && isSoldTransaction(p)) { %>
                    <span class="dashboard-note" style="display:inline;margin:0;font-size:11px;">Sold - locked</span>
                  <% } else { %>
                    <a class="btn" href="/parts/<%= p.id %>/edit" style="font-size:11px;padding:4px 8px;">EditParts</a>
                    <form method="post" action="/parts/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this entry?')">
                      <button type="submit" class="btn" style="font-size:11px;padding:4px 8px;background:#c0392b;">Del</button>
                    </form>
                  <% } %>
                <% } %>
              </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (view.isFrontline) { %>
    <article class="dashboard-card admin-panel" id="approved-transfers" style="margin-top:12px;">
      <div class="dashboard-card__header admin-panel-header">Approved transfers - verify receipt</div>
      <p class="dashboard-note admin-note">Verify approved transfers received at <%= actorBranch || 'your assigned branch' %>. Approval completes the transit status and updates branch inventory.</p>
      <label style="display:flex;flex-direction:column;font-weight:700;font-size:13px;max-width:320px;margin:10px 0 0 0;">Receiver ID Barcode
        <input type="text" id="branch-receive-receiver" placeholder="Swipe your ID barcode" autocomplete="off" />
        <small class="dashboard-note" style="margin:4px 0 0 0;">Only the logged-in receiver can confirm receipt.</small>
      </label>
      <div class="table-scroll" style="max-height:min(52vh, calc(100vh - 220px));">
        <% const inboundRows = Array.isArray(inboundTransfers) ? inboundTransfers : []; %>
        <% const byTransaction = new Map(); %>
        <% inboundRows.forEach((row) => { %>
          <% const txnKey = String(row.transaction_number || ''); %>
          <% if (!byTransaction.has(txnKey)) byTransaction.set(txnKey, []); %>
          <% byTransaction.get(txnKey).push(row); %>
        <% }) %>
        <% if (!inboundRows.length) { %>
          <p style="padding:12px;">No approved transfers waiting for receipt.</p>
        <% } else { %>
          <% Array.from(byTransaction.entries()).forEach(([txnNumber, rows]) => { %>
            <div style="margin-bottom:16px;border:1px solid #ccc;border-radius:4px;overflow:hidden;">
              <div style="background:#f5f5f5;padding:8px 12px;display:flex;justify-content:space-between;align-items:center;font-weight:bold;border-bottom:1px solid #ddd;">
                <span>Transaction <%= txnNumber %> (<%= rows.length %> line<%= rows.length === 1 ? '' : 's' %>)</span>
                <button type="button" class="btn branch-receive-all-btn" data-transaction-number="<%= txnNumber %>" style="background:#27ae60;color:#fff;font-size:11px;padding:4px 8px;">Verify and Approve All</button>
              </div>
              <table class="list" style="margin:0;border:none;border-radius:0;">
                <thead><tr><th>Part Number</th><th>Part Name</th><th>Sub-ID</th><th>Qty</th><th>Status</th><th></th></tr></thead>
                <tbody>
                  <% rows.forEach((row) => { %>
                    <tr>
                      <td><%= row.part_number || '' %></td>
                      <td><%= row.part_name || '' %></td>
                      <td><%= row.sub_id || '' %></td>
                      <td><%= row.qty != null ? row.qty : '' %></td>
                      <td><%= row.fulfillment_status || row.request_status || 'In transit' %></td>
                      <td><form method="post" action="/parts/receive/<%= encodeURIComponent(row.id) %>" class="branch-receive-one-form" style="margin:0;">
  <input type="hidden" name="receiver_barcode" class="branch-receive-receiver-hidden" value="" />
  <button type="submit" class="btn" style="background:#1f8f53;">Verify and Approve</button>
</form></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% }) %>
        <% } %>
      </div>
    </article>
  <% } %>
</section>

<script src="/js/parts-report-modal.js"></script>
<% if (view.isFrontline) { %>
<script>
  const receiverInput = document.getElementById('branch-receive-receiver');
  document.querySelectorAll('.branch-receive-one-form').forEach((form) => {
    form.addEventListener('submit', (event) => {
      const receiverBarcode = receiverInput ? String(receiverInput.value || '').trim() : '';
      if (!receiverBarcode) {
        event.preventDefault();
        window.alert('Swipe your ID barcode first.');
        if (receiverInput) receiverInput.focus();
        return;
      }
      const hidden = form.querySelector('.branch-receive-receiver-hidden');
      if (hidden) hidden.value = receiverBarcode;
    });
  });

  document.querySelectorAll('.branch-receive-all-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const transactionNumber = button.dataset.transactionNumber;
      if (!transactionNumber || !window.confirm(`Approve all transfers for transaction ${transactionNumber}?`)) return;
      button.disabled = true;
      try {
        const receiverBarcode = receiverInput ? String(receiverInput.value || '').trim() : '';
        if (!receiverBarcode) {
          window.alert('Swipe your ID barcode first.');
          if (receiverInput) receiverInput.focus();
          button.disabled = false;
          return;
        }
        const response = await fetch(`/parts/api/receive-all/${encodeURIComponent(transactionNumber)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ receiver_barcode: receiverBarcode }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Unable to receive transfers.');
        window.location.href = `/parts?success=${encodeURIComponent(`Received ${result.transfersReceived} transfer(s) for transaction ${transactionNumber}.`)}`;
      } catch (error) {
        window.alert(error.message || 'Unable to receive transfers.');
        button.disabled = false;
      }
    });
  });
</script>
<% } %>

<%- include('../partials/footer') %>

