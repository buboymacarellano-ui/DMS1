<%- include('../partials/header') %>

<section class="dashboard-shell admin-shell">
  <% const view = typeof partsView !== 'undefined' && partsView ? partsView : { isFrontline: false, scope: 'all', readOnly: false, label: 'Parts Database', location: '' }; %>
  <div class="dashboard-title admin-title"><%= view.label || 'Parts Database' %></div>

  <% if (error) { %><p class="error" style="font-weight:700;margin-bottom:10px;"><%= error %></p><% } %>
  <% if (success) { %><p class="success" style="font-weight:700;margin-bottom:10px;"><%= success %></p><% } %>

  <% if (view.isFrontline) { %>
    <p class="dashboard-note admin-note">
      Default view is <strong>your branch only</strong>. Open the Warehouse 1 card to look up warehouse stock without changing your branch records.
    </p>
    <div class="pm-grid parts-scope-cards" style="margin-bottom:14px;">
      <article class="dashboard-card admin-panel pm-panel<%= view.scope === 'branch' ? ' parts-scope-card--active' : '' %>">
        <div class="dashboard-card__header admin-panel-header pm-panel-header">
          <span><%= actorBranch || 'Branch' %> Parts Database</span>
          <% if (view.scope === 'branch') { %><span class="pm-badge">Default</span><% } %>
        </div>
        <p class="dashboard-note admin-note">Only parts and transactions for <%= actorBranch || 'your assigned branch' %>.</p>
        <a class="btn" href="/parts" style="background:#1a6bbf;">View branch database</a>
      </article>
      <article class="dashboard-card admin-panel pm-panel<%= view.scope === 'warehouse1' ? ' parts-scope-card--active' : '' %>">
        <div class="dashboard-card__header admin-panel-header pm-panel-header">
          <span>Warehouse 1</span>
          <% if (view.scope === 'warehouse1') { %><span class="pm-badge">Viewing</span><% } %>
        </div>
        <p class="dashboard-note admin-note">Read-only Warehouse 1 parts database and transactions.</p>
        <a class="btn" href="/parts?scope=warehouse1" style="background:#0f6d8c;">View Warehouse 1</a>
      </article>
    </div>
  <% } %>

  <% const lookups = typeof reportLookups !== 'undefined' && reportLookups ? reportLookups : { suppliers: [], warehouses: [], partNumbers: [] }; %>
  <div class="parts-action-row">
    <% if (!view.readOnly) { %>
    <a class="btn" href="/parts/new" style="background:#1a6bbf;">+ New Entry</a>
    <a class="btn" href="#parts-records" style="background:#1f8f53;">EditParts</a>
    <% } %>
    <span class="dashboard-note admin-note" style="margin:0;">Visible records: <strong><%= total %></strong> · Restock rows hide from this table after 3 working days but stay in History</span>
    <div class="report-export">
      <button type="button" class="btn report-export__btn" id="parts-report-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="parts-report-modal">
        Create Report
      </button>
    </div>
  </div>

  <div id="parts-report-modal" class="parts-report-modal" hidden>
    <div class="parts-report-modal__backdrop" data-report-close></div>
    <form id="parts-report-form" class="parts-report-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="parts-report-title">
      <header class="parts-report-modal__header">
        <h2 id="parts-report-title">Advanced Report Pre-Sorter</h2>
        <button type="button" class="parts-report-modal__close" data-report-close aria-label="Close">&times;</button>
      </header>
      <div class="parts-report-modal__body">
        <label>Targeted Report
          <select id="report-type" name="type" required>
            <option value="">Select a report…</option>
            <option value="lifecycle">1. Single Part Lifecycle</option>
            <option value="date-range">2. Report by Date Range</option>
            <option value="supplier">3. Report by Supplier</option>
            <option value="warehouse">4. Report by Warehouse</option>
            <option value="audit">5. System Audit Trail</option>
            <option value="low-stock">6. Critical Low Stock Report</option>
            <% if (!view.isFrontline) { %>
            <option value="whole-database">7. Download Whole Database CSV</option>
            <% } %>
          </select>
        </label>
        <p id="report-type-hint" class="dashboard-note admin-note">Choose a report to reveal the matching criteria.</p>

        <div class="report-criteria" data-for="lifecycle" hidden>
          <label>Part Number
            <input id="report-part-number" name="partNumber" list="report-part-options" placeholder="Enter or select a part number" autocomplete="off" />
          </label>
        </div>
        <div class="report-criteria" data-for="date-range audit" hidden>
          <label>Month
            <input id="report-month" name="month" type="month" />
          </label>
          <div class="parts-report-modal__dates">
            <label>Start Date
              <input id="report-start-date" name="startDate" type="date" />
            </label>
            <label>End Date
              <input id="report-end-date" name="endDate" type="date" />
            </label>
          </div>
        </div>
        <div class="report-criteria" data-for="supplier" hidden>
          <label>Supplier
            <input id="report-supplier" name="supplier" list="report-supplier-options" placeholder="Type or select supplier" autocomplete="off" />
          </label>
        </div>
        <div class="report-criteria" data-for="warehouse" hidden>
          <label>Warehouse / Location
            <input id="report-warehouse" name="warehouse" list="report-warehouse-options" placeholder="Type or select warehouse" autocomplete="off" />
          </label>
        </div>
        <div class="report-criteria" data-for="low-stock" hidden>
          <label>Safe minimum threshold
            <input id="report-threshold" name="threshold" type="number" min="0" step="1" placeholder="Leave blank to use each part's safe minimum (default 5)" />
          </label>
        </div>

        <datalist id="report-part-options">
          <% (lookups.partNumbers || []).forEach((value) => { %>
            <option value="<%= value %>"></option>
          <% }) %>
        </datalist>
        <datalist id="report-supplier-options">
          <% (lookups.suppliers || []).forEach((value) => { %>
            <option value="<%= value %>"></option>
          <% }) %>
        </datalist>
        <datalist id="report-warehouse-options">
          <% (lookups.warehouses || []).forEach((value) => { %>
            <option value="<%= value %>"></option>
          <% }) %>
        </datalist>
      </div>
      <footer class="parts-report-modal__footer">
        <button type="button" class="btn" data-report-close>Cancel</button>
        <button type="submit" class="btn parts-report-modal__generate">Generate Report</button>
      </footer>
    </form>
  </div>

  <form method="get" action="/parts" class="form" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:14px;">
    <% if (view.scope === 'warehouse1') { %><input type="hidden" name="scope" value="warehouse1" /><% } %>
    <label style="margin:0;">Search
      <input name="q" value="<%= q %>" placeholder="Part #, name, Sub-ID, supplier, work order..." style="min-width:220px;" />
    </label>
    <label style="margin:0;">Type
      <select name="type">
        <option value="">All Types</option>
        <% transactionTypes.forEach(t => { %>
            <option value="<%= t %>" <%= (typeof normalizePartsTransactionType === 'function' ? normalizePartsTransactionType(filterType) : filterType) === t ? 'selected' : '' %>><%= displayPartsTransactionType(t) %></option>
        <% }) %>
      </select>
    </label>
    <button type="submit">Filter</button>
    <a class="btn" href="<%= view.scope === 'warehouse1' ? '/parts?scope=warehouse1' : '/parts' %>">Clear</a>
  </form>

  <div id="parts-records" class="table-scroll" style="overflow-x:auto;max-height:72vh;overflow-y:auto;">
    <table class="list" style="min-width:max-content;font-size:12px;">
      <thead style="position:sticky;top:0;z-index:5;">
        <tr>
          <th>#</th>
          <th style="white-space:nowrap;">Transaction Date</th>
          <th style="white-space:nowrap;">Transaction Type</th>
          <th style="white-space:nowrap;">Present Location</th>
          <th style="white-space:nowrap;">Editor</th>
          <th style="white-space:nowrap;">Part Number</th>
          <th style="white-space:nowrap;">Part Name</th>
          <th style="white-space:nowrap;">Sub-ID</th>
          <th style="white-space:nowrap;">Generic</th>
          <th style="white-space:nowrap;">Supplier</th>
          <th style="white-space:nowrap;">Qty</th>
          <th style="white-space:nowrap;">On-Hand</th>
          <th style="white-space:nowrap;">Cost Price</th>
          <th style="white-space:nowrap;">Markup (%)</th>
          <th style="white-space:nowrap;">Retail Price</th>
          <th style="white-space:nowrap;">Sold To (WO#)</th>
          <th style="white-space:nowrap;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!parts.length) { %>
          <tr><td colspan="17" style="text-align:center;padding:20px;">No records found.</td></tr>
        <% } %>
        <% parts.forEach((p, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td style="white-space:nowrap;"><%= p.transaction_date || '' %></td>
            <td style="white-space:nowrap;">
              <span style="font-weight:700;">
                <%= displayPartsTransactionType(p.transaction_type) %>
              </span>
            </td>
            <td style="white-space:nowrap;">
              <%= p.present_location || p.branch || p.requesting_branch || '—' %>
            </td>
            <td style="white-space:nowrap;"><%= p.editor || '' %></td>
            <td style="white-space:nowrap;"><%= p.part_number || '' %></td>
            <td style="white-space:nowrap;"><%= p.part_name || '' %></td>
            <td style="white-space:nowrap;"><%= p.sub_id || '' %></td>
            <td style="white-space:nowrap;"><%= p.generic || '' %></td>
            <td style="white-space:nowrap;"><%= p.supplier || '' %></td>
            <td style="text-align:right;"><%= p.qty != null ? p.qty : '' %></td>
            <td style="text-align:right;"><%= p.on_hand != null ? p.on_hand : '' %></td>
            <td style="text-align:right;"><%= p.cost_price != null ? Number(p.cost_price).toFixed(2) : '' %></td>
            <td style="text-align:right;"><%= p.markup != null ? p.markup : '' %></td>
            <td style="text-align:right;"><%= p.retail_price != null ? Number(p.retail_price).toFixed(2) : '' %></td>
            <td style="white-space:nowrap;"><%= p.sold_to || '' %></td>
            <td style="white-space:nowrap;">
              <a class="btn" href="/parts/history/<%= encodeURIComponent(p.part_number || '') %><%= view.scope === 'warehouse1' ? '?scope=warehouse1' : '' %>" style="font-size:11px;padding:4px 8px;">History</a>
              <% if (!view.readOnly) { %>
              <a class="btn" href="/parts/<%= p.id %>/edit" style="font-size:11px;padding:4px 8px;">EditParts</a>
              <form method="post" action="/parts/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this entry?')">
                <button type="submit" class="btn" style="font-size:11px;padding:4px 8px;background:#c0392b;">Del</button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<script>
  (function initPartsReportModal() {
    var btn = document.getElementById('parts-report-btn');
    var modal = document.getElementById('parts-report-modal');
    var form = document.getElementById('parts-report-form');
    var typeSelect = document.getElementById('report-type');
    var hint = document.getElementById('report-type-hint');
    if (!btn || !modal || !form || !typeSelect) return;

    var hints = {
      lifecycle: 'Tracks one Part Number through its full lifetime history and current on-hand quantity.',
      'date-range': 'Filter records by month or a custom start/end date window.',
      supplier: 'Limit the report to a specific supplier.',
      warehouse: 'Sort and list parts by warehouse or present location.',
      audit: 'Side-by-side restock and sold transactions for accounting verification. Optional date window.',
      'low-stock': 'Lists catalog items whose current stock is at or below the safe minimum.',
      'whole-database': 'Downloads every parts-database row as a CSV file. No extra filters required.'
    };

    function openModal() {
      modal.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      typeSelect.focus();
    }

    function closeModal() {
      modal.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    }

    function syncCriteria() {
      var selected = typeSelect.value;
      hint.textContent = hints[selected] || 'Choose a report to reveal the matching criteria.';
      modal.querySelectorAll('.report-criteria').forEach(function (block) {
        var types = String(block.getAttribute('data-for') || '').split(/\s+/);
        block.hidden = types.indexOf(selected) === -1;
      });
    }

    btn.addEventListener('click', function (event) {
      event.preventDefault();
      if (modal.hidden) openModal();
      else closeModal();
    });

    modal.querySelectorAll('[data-report-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !modal.hidden) closeModal();
    });

    typeSelect.addEventListener('change', syncCriteria);

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var type = typeSelect.value;
      if (!type) {
        typeSelect.focus();
        return;
      }
      if (type === 'lifecycle' && !document.getElementById('report-part-number').value.trim()) {
        document.getElementById('report-part-number').focus();
        return;
      }
      if (type === 'supplier' && !document.getElementById('report-supplier').value.trim()) {
        document.getElementById('report-supplier').focus();
        return;
      }
      if (type === 'warehouse' && !document.getElementById('report-warehouse').value.trim()) {
        document.getElementById('report-warehouse').focus();
        return;
      }

      var params = new URLSearchParams();
      params.set('type', type);
      <% if (view.scope === 'warehouse1') { %>params.set('scope', 'warehouse1');<% } %>
      var fields = {
        partNumber: document.getElementById('report-part-number'),
        startDate: document.getElementById('report-start-date'),
        endDate: document.getElementById('report-end-date'),
        month: document.getElementById('report-month'),
        supplier: document.getElementById('report-supplier'),
        warehouse: document.getElementById('report-warehouse'),
        threshold: document.getElementById('report-threshold')
      };
      Object.keys(fields).forEach(function (key) {
        var value = fields[key] && String(fields[key].value || '').trim();
        if (value) params.set(key, value);
      });

      window.open('/api/reports/generate?' + params.toString(), '_blank', 'noopener');
    });

    syncCriteria();
  })();
</script>

<%- include('../partials/footer') %>

