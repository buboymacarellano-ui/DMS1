<%- include('../partials/header') %>

<section class="dashboard-shell admin-shell pm-shell" id="receiving-panel">
  <div class="dashboard-title admin-title role-dashboard-title"><span>Receiving</span> <span class="role-dashboard-title__suffix">Transactions</span></div>
  <p class="dashboard-note">Approve parts deliveries from Warehouse 1. Once confirmed, items will be added to your branch warehouse inventory.</p>

  <% if (success) { %>
    <p style="color:#1f7a32;font-weight:700;"><%= success %></p>
  <% } %>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <article class="dashboard-card admin-panel pm-panel">
    <div class="dashboard-card__header admin-panel-header pm-panel-header">
      <span>Pending Deliveries</span>
      <span id="receiving-count" class="pm-badge"><%= receivingList.length %></span>
    </div>
    
    <% if (!receivingList || receivingList.length === 0) { %>
      <p class="dashboard-note admin-note" style="padding:20px 0;">No pending deliveries to receive.</p>
    <% } else { %>
      <div class="table-scroll pm-table-wrap">
        <table class="list pm-data-table" id="receiving-table">
          <thead>
            <tr>
              <th>Part #</th>
              <th>Part Name</th>
              <th>Supplier</th>
              <th>Qty</th>
              <th>Cost Price</th>
              <th>Markup (%)</th>
              <th>Retail Price</th>
              <th>Sent By</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% receivingList.forEach((row) => { %>
              <tr class="pm-data-row" data-tx-id="<%= row.id %>">
                <td><%= row.part_number %></td>
                <td><%= row.part_name || '-' %></td>
                <td><%= row.supplier || '-' %></td>
                <td class="pm-qty-cell"><%= row.qty %></td>
                <td>₱ <%= Number(row.cost_price || 0).toFixed(2) %></td>
                <td><%= Number(row.markup || 0).toFixed(2) %>%</td>
                <td>₱ <%= Number(row.retail_price || 0).toFixed(2) %></td>
                <td><%= row.sent_by || row.created_by || '-' %></td>
                <td><%= new Date(row.created_at).toLocaleDateString('en-PH') %></td>
                <td>
                  <form method="post" action="/receiving/<%= row.id %>/confirm" style="display:inline;">
                    <button type="submit" class="btn" style="background:#1f7a32;color:#fff;">Received</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </article>
</section>

<%- include('../partials/footer') %>
