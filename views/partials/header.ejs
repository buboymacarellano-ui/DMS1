<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Auto Shop Manager</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<% const activeRole = currentUser ? String(currentUser.role || '').toLowerCase() : ''; %>
<%
  const roleLabelMap = {
    general_manager: 'GM',
    technician: 'TECH',
    service_technical_manager: 'STM',
    parts_manager: 'PM',
    pm: 'PM',
    parts_clerk: 'PCLK',
    finance_manager: 'FM',
    fm: 'FM',
    accounting: 'ACCT',
    assets_facilities: 'A&F',
    admin: 'ADMIN',
    hr: 'HM',
    hr_manager: 'HM',
    hr_generalist: 'GEN',
    payroll: 'PAY',
    hr_clerk: 'HRC',
    service_advisor: 'SA',
    senior_service_receptionist: 'SSR',
    service_receptionist: 'SR',
    operations_manager: 'OM',
    store_manager: 'SM',
    cashier: 'CASH',
    stores_clerk: 'SCLK',
  };
%>
<body class="<%= ['service_advisor', 'service_receptionist', 'senior_service_receptionist'].includes(activeRole) ? 'role-frontline' : (activeRole === 'service_technical_manager' ? 'role-stm' : ((activeRole === 'parts_manager' || activeRole === 'pm') ? 'role-pm' : ((activeRole === 'finance_manager' || activeRole === 'fm' || activeRole === 'accounting') ? 'role-fm' : (activeRole === 'assets_facilities' ? 'role-fm' : (activeRole === 'general_manager' ? 'role-gm' : ''))))) %>">
  <% const pathNow = typeof currentPath !== 'undefined' && currentPath ? String(currentPath) : ''; %>
  <% const queryScope = typeof currentQuery !== 'undefined' && currentQuery ? String(currentQuery.scope || currentQuery.location || '').toLowerCase() : ''; %>
  <% const viewingWarehouse1 = pathNow.indexOf('/parts') === 0 && queryScope.indexOf('warehouse') !== -1; %>
  <% const isPmRole = activeRole === 'parts_manager' || activeRole === 'pm'; %>
  <% const isFmRole = activeRole === 'finance_manager' || activeRole === 'fm' || activeRole === 'accounting'; %>
  <% const isAfRole = activeRole === 'assets_facilities'; %>
  <% const isServicePortalRole = ['service_advisor', 'service_receptionist', 'senior_service_receptionist', 'technician', 'service_technical_manager'].includes(activeRole); %>
  <% const isFinancePortalRole = activeRole === 'admin' || isFmRole; %>
  <% const roleLabel = roleLabelMap[activeRole] || 'USER'; %>
  <% const cleanSessionHeader = activeRole === 'general_manager' || isServicePortalRole || isFinancePortalRole || isPmRole || isAfRole; %>
  <% const cleanHomePath = activeRole === 'general_manager' ? '/gm' : (activeRole === 'service_technical_manager' ? '/stm' : (activeRole === 'technician' ? '/technician' : (isServicePortalRole ? '/service-receptionist' : (isFinancePortalRole ? (isFmRole ? '/finance' : '/admin') : (isAfRole ? '/gm/fte' : '/parts-manager'))))); %>
  <%
    const roleHomeByRole = {
      general_manager: '/gm',
      admin: '/admin',
      hr: '/hr/portal',
      hr_manager: '/hr/portal',
      hr_generalist: '/hr/portal',
      payroll: '/hr/payroll',
      hr_clerk: '/hr/portal',
      service_technical_manager: '/stm',
      technician: '/technician',
      parts_manager: '/parts-manager',
      pm: '/parts-manager',
      parts_clerk: '/parts-portal',
      finance_manager: '/finance',
      fm: '/finance',
      accounting: '/finance',
      assets_facilities: '/gm/fte',
      service_receptionist: '/service-receptionist',
      senior_service_receptionist: '/service-receptionist',
      service_advisor: '/service-receptionist',
      operations_manager: '/stores',
      store_manager: '/stores',
      cashier: '/stores/pos',
      stores_clerk: '/stores',
    };
    const roleHomePath = roleHomeByRole[activeRole] || '/';
    const normalizedPath = String(pathNow || '').replace(/\/+$/, '') || '/';
    const normalizedHome = String(roleHomePath || '/').replace(/\/+$/, '') || '/';
    const isHomePage = !activeRole
      ? (normalizedPath === '/' || normalizedPath === '/auth/login')
      : (normalizedPath === normalizedHome);
  %>
  <header class="site-header<%= cleanSessionHeader ? ' site-header--gm site-header--gm-clean' : '' %>">
    <% if (typeof portalLabel !== 'undefined' && portalLabel) { %>
      <span class="portal-watermark" aria-hidden="true"><%= portalLabel %></span>
    <% } %>
    <% if (cleanSessionHeader) { %>
      <div class="site-header__left site-header__left--gm-stack">
        <% if (currentUser) { %>
          <span class="header-user-badge header-user-badge--gm-lead" title="Signed-in <%= roleLabel %>">
            <%= roleLabel %>: <%= currentUser.username %>
          </span>
        <% } else { %>
          <span class="header-user-badge header-user-badge--gm-lead"><%= roleLabel %></span>
        <% } %>
        <div class="site-header__logo-wrap">
          <h1 class="site-header__brand-left">
            <a href="<%= cleanHomePath %>" class="brand-heading" aria-label="<%= roleLabel %> Dashboard" title="<%= roleLabel %> Dashboard">
              <span class="brand-text">
                <span class="brand-text__name">A&amp;E Auto Service</span>
                <span class="brand-text__entity">GROUP INC.</span>
              </span>
            </a>
          </h1>
          <% if (!isHomePage) { %>
            <%- include('back-button', { backChipMode: 'under-logo' }) %>
          <% } %>
        </div>
      </div>

      <div class="site-header__actions" aria-label="Session actions">
        <div class="site-header__session-btns">
          <button type="button" id="fullscreen-toggle" class="btn btn-fullscreen">Full Screen</button>
          <% if (currentUser) { %>
            <form method="post" action="/auth/logout" class="header-logout-form">
              <button type="submit" class="btn btn-fullscreen">Log Out</button>
            </form>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="site-header__logo-wrap">
        <h1>
          <a href="/" class="brand-heading" aria-label="Return to main page" title="Return to main page">
            <span class="brand-text">
              <span class="brand-text__name">A&amp;E Auto Service</span>
              <span class="brand-text__entity">GROUP INC.</span>
            </span>
          </a>
        </h1>
        <% if (!isHomePage) { %>
          <%- include('back-button', { backChipMode: 'under-logo' }) %>
        <% } %>
      </div>
      <nav>
        <% if (activeRole === 'technician') { %>
          <a href="/technician">Technician</a>
        <% } else if (activeRole === 'service_technical_manager') { %>
          <a href="/stm">STM Dashboard</a>
          <a href="/service">Service Portal</a>
          <a href="/gm/fte" class="<%= pathNow === '/gm/fte' ? 'nav-link--active' : '' %>">FTE Tracking</a>
        <% } else if (activeRole === 'admin') { %>
          <a href="/admin">Finance Office</a>
          <a href="/gm/fte" class="<%= pathNow === '/gm/fte' ? 'nav-link--active' : '' %>">Assets &amp; Facilities</a>
          <a href="/finance">Accounting</a>
          <a href="/admin/gates/removed-records">Removed Records</a>
        <% } else if (['hr', 'hr_manager', 'hr_generalist', 'payroll', 'hr_clerk'].includes(activeRole)) { %>
          <a href="/hr/portal">HR Portal</a>
          <a href="/hr">HR Dashboard</a>
          <a href="/hr/rosters">Shift Rosters</a>
          <% if (typeof canGrant === 'function' && canGrant('hr', 'view_payroll')) { %>
            <a href="/hr/payroll">Payroll</a>
          <% } %>
        <% } else if (['service_receptionist', 'senior_service_receptionist', 'service_advisor'].includes(activeRole)) { %>
          <a href="/service-receptionist" class="<%= pathNow.indexOf('/service-receptionist') === 0 ? 'nav-link--active' : '' %>"><%= roleLabel %> Dashboard</a>
          <a href="/service">Service Portal</a>
        <% } else if (activeRole === 'parts_clerk') { %>
          <a href="/parts-portal">Parts Portal</a>
        <% } else if (['operations_manager', 'store_manager', 'cashier', 'stores_clerk'].includes(activeRole)) { %>
          <a href="/stores">Stores Portal</a>
        <% } %>
        <% if (activeRole === 'admin' || activeRole === 'hr' || activeRole === 'hr_manager' || activeRole === 'hr_generalist' || activeRole === 'hr_clerk') { %>
          <a href="/employees">Employee DB</a>
        <% } %>
        <% if (canApproveRequests) { %>
          <a href="/approvals" class="approval-nav <%= pendingApprovalCount > 0 ? 'approval-nav--pending' : '' %>" title="Approval requests">
            Approvals<% if (pendingApprovalCount > 0) { %> <span class="approval-nav__count"><%= pendingApprovalCount %></span><% } %>
          </a>
        <% } else if (currentUser) { %>
          <a href="/approvals" class="approval-nav" title="Submit or view approval requests">Requests</a>
        <% } %>
        <% if (currentUser) { %>
          <span class="header-user-badge"><%= roleLabel %>: <%= currentUser.username %><%= ['service_receptionist', 'senior_service_receptionist', 'service_advisor'].includes(activeRole) && currentUser.branch ? ` | ${currentUser.branch}` : '' %></span>
        <% } %>
        <button type="button" id="fullscreen-toggle" class="btn btn-fullscreen">Full Screen</button>
        <% if (currentUser) { %>
          <form method="post" action="/auth/logout" class="header-logout-form">
            <button type="submit" class="btn btn-fullscreen">Log Out</button>
          </form>
        <% } %>
      </nav>
    <% } %>
  </header>
  <main class="container">
    <% if (typeof globalError !== 'undefined' && globalError) { %>
      <p class="error global-error-message"><%= globalError %></p>
    <% } %>
