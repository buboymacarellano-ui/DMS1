<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Auto Shop Manager</title>
  <link rel="stylesheet" href="/fonts/inter.css">
  <link rel="stylesheet" href="/styles.css">
  <script>
    try { if (window.localStorage.getItem('ae_night_mode') === '1') document.documentElement.classList.add('night-mode'); } catch (e) {}
    try { if (window.localStorage.getItem('dms-sidebar-hidden') === '1') document.documentElement.classList.add('sidebar-hidden'); } catch (e) {}
  </script>
</head>
<% const activeRole = currentUser ? String(currentUser.role || '').toLowerCase() : ''; %>
<%
  const isGmRole = activeRole === 'general_manager' || activeRole === 'gm';
  const roleLabelMap = {
    general_manager: 'GM',
    gm: 'GM',
    technician: 'TECH',
    service_technical_manager: 'STM',
    parts_manager: 'PM',
    pm: 'PM',
    parts_clerk: 'PCLK',
    finance_manager: 'FM',
    fm: 'FM',
    accounting: 'ACCT',
    assets_facilities: 'A&F',
    admin: 'ADMIN',
    hr: 'HM',
    hr_manager: 'HM',
    hr_generalist: 'GEN',
    payroll: 'PAY',
    hr_clerk: 'HRC',
    service_advisor: 'SA',
    senior_service_receptionist: 'SSR',
    service_receptionist: 'SR',
    operations_manager: 'OM',
    store_manager: 'SM',
    cashier: 'CASH',
    stores_clerk: 'SCLK',
  };
%>
<body class="<%= ['service_advisor', 'service_receptionist', 'senior_service_receptionist'].includes(activeRole) ? 'role-frontline' : (activeRole === 'service_technical_manager' ? 'role-stm' : ((activeRole === 'parts_manager' || activeRole === 'pm') ? 'role-pm' : ((activeRole === 'finance_manager' || activeRole === 'fm' || activeRole === 'accounting') ? 'role-fm' : (activeRole === 'assets_facilities' ? 'role-fm' : (isGmRole ? 'role-gm' : ''))))) %>">
  <% const pathNow = typeof currentPath !== 'undefined' && currentPath ? String(currentPath) : ''; %>
  <% const queryScope = typeof currentQuery !== 'undefined' && currentQuery ? String(currentQuery.scope || currentQuery.location || '').toLowerCase() : ''; %>
  <% const viewingWarehouse1 = pathNow.indexOf('/parts') === 0 && queryScope.indexOf('warehouse') !== -1; %>
  <% const isPmRole = activeRole === 'parts_manager' || activeRole === 'pm'; %>
  <% const isFmRole = activeRole === 'finance_manager' || activeRole === 'fm' || activeRole === 'accounting'; %>
  <% const isAfRole = activeRole === 'assets_facilities'; %>
  <% const isHrRole = ['hr', 'hr_manager', 'hr_generalist', 'payroll', 'hr_clerk'].includes(activeRole); %>
  <% const isServicePortalRole = ['service_advisor', 'service_receptionist', 'senior_service_receptionist', 'technician', 'service_technical_manager'].includes(activeRole); %>
  <% const isFinancePortalRole = activeRole === 'admin' || isFmRole; %>
  <% const roleLabel = roleLabelMap[activeRole] || 'USER'; %>
  <% const headerBranch = currentUser && typeof signedInBranch !== 'undefined' ? signedInBranch : ''; %>
  <% const cleanSessionHeader = isGmRole || isServicePortalRole || isFinancePortalRole || isPmRole || isAfRole || isHrRole; %>
  <% const cleanHomePath = isGmRole ? '/gm' : (activeRole === 'service_technical_manager' ? '/stm' : (activeRole === 'technician' ? '/technician' : (isServicePortalRole ? '/service-receptionist' : (isFinancePortalRole ? (isFmRole ? '/finance' : '/admin') : (isAfRole ? '/gm/fte' : (isHrRole ? '/hr/portal' : '/parts-manager')))))); %>
  <%
    const roleHomeByRole = {
      general_manager: '/gm',
      gm: '/gm',
      admin: '/admin',
      hr: '/hr/portal',
      hr_manager: '/hr/portal',
      hr_generalist: '/hr/portal',
      payroll: '/hr/payroll',
      hr_clerk: '/hr/portal',
      service_technical_manager: '/stm',
      technician: '/technician',
      parts_manager: '/parts-manager',
      pm: '/parts-manager',
      parts_clerk: '/parts-portal',
      finance_manager: '/finance',
      fm: '/finance',
      accounting: '/finance',
      assets_facilities: '/gm/fte',
      service_receptionist: '/service-receptionist',
      senior_service_receptionist: '/service-receptionist',
      service_advisor: '/service-receptionist',
      operations_manager: '/stores',
      store_manager: '/stores',
      cashier: '/stores/pos',
      stores_clerk: '/stores',
    };
    const roleHomePath = roleHomeByRole[activeRole] || '/';
    const normalizedPath = String(pathNow || '').replace(/\/+$/, '') || '/';
    const normalizedHome = String(roleHomePath || '/').replace(/\/+$/, '') || '/';
    const isHomePage = !activeRole
      ? (normalizedPath === '/' || normalizedPath === '/auth/login')
      : (normalizedPath === normalizedHome);
  %>
  <header class="site-header<%= cleanSessionHeader ? ' site-header--gm site-header--gm-clean' : '' %>">
    <% if (typeof portalLabel !== 'undefined' && portalLabel) { %>
      <span class="portal-watermark" aria-hidden="true"><%= portalLabel %></span>
    <% } %>
    <% if (cleanSessionHeader) { %>
      <div class="site-header__left site-header__left--gm-stack">
        <% if (currentUser) { %>
          <span class="header-user-badge header-user-badge--gm-lead" title="Signed-in <%= roleLabel %>">
            <%= roleLabel %>: <%= currentUser.username %>
          </span>
        <% } else { %>
          <span class="header-user-badge header-user-badge--gm-lead"><%= roleLabel %></span>
        <% } %>
        <div class="site-header__logo-wrap">
          <h1 class="site-header__brand-left">
            <a href="<%= cleanHomePath %>" class="brand-heading" aria-label="<%= roleLabel %> Dashboard" title="<%= roleLabel %> Dashboard">
              <span class="brand-text">
                <span class="brand-text__name">A&amp;E Auto Service</span>
                <span class="brand-text__entity">GROUP INC.</span>
              </span>
            </a>
          </h1>
          <% if (!isHomePage) { %>
            <%- include('back-button', { backChipMode: 'under-logo' }) %>
          <% } %>
        </div>
      </div>
      <% if (isGmRole) { %>
        <%
          const gmMenuRef = (typeof gmMenu !== 'undefined' && gmMenu) ? gmMenu : null;
          const gmWorkspacesHref = gmMenuRef && gmMenuRef.GM_HUBS && gmMenuRef.GM_HUBS['work-spaces'] ? gmMenuRef.GM_HUBS['work-spaces'].href : '/gm/work-spaces';
          const gmMoreHref = gmMenuRef && gmMenuRef.GM_HUBS && gmMenuRef.GM_HUBS.more ? gmMenuRef.GM_HUBS.more.href : '/gm/more';
          const isGmHubPath = (slug, path) => (gmMenuRef && typeof gmMenuRef.hubMatchesPath === 'function')
            ? gmMenuRef.hubMatchesPath(slug, path)
            : (slug === 'work-spaces' ? path.indexOf('/gm/work-spaces') === 0 : path.indexOf('/gm/more') === 0);
          const gmPending = typeof pendingApprovalCount !== 'undefined' ? Number(pendingApprovalCount || 0) : 0;
          const gmHeaderNav = [
            { label: 'GM Dashboard', href: '/gm', active: normalizedPath === '/gm' || normalizedPath === '/gm/aging' || normalizedPath.indexOf('/gm/aging/') === 0 },
            { label: 'Targets & Incentives', href: '/gm/targets-incentives', active: normalizedPath.indexOf('/gm/targets-incentives') === 0 || normalizedPath.indexOf('/gm/performance-incentives') === 0 },
            { label: 'Approvals', href: '/approvals', active: normalizedPath.indexOf('/approvals') === 0, badge: gmPending > 0 ? gmPending : 0 },
            { label: 'Control Panel', href: '/gm/control-panel', active: normalizedPath.indexOf('/gm/control-panel') === 0 },
            { label: 'My Record', href: '/gm/my-record', active: normalizedPath.indexOf('/gm/my-record') === 0 },
            { label: 'Work Spaces', href: gmWorkspacesHref, active: isGmHubPath('work-spaces', normalizedPath) },
            { label: 'More', href: gmMoreHref, active: isGmHubPath('more', normalizedPath) && !isGmHubPath('work-spaces', normalizedPath) },
          ];
        %>
        <nav class="gm-billiard-nav" aria-label="GM quick navigation">
          <% gmHeaderNav.forEach((item, idx) => { %>
            <a
              href="<%= item.href %>"
              class="gm-billiard-nav__ball<%= item.active ? ' gm-billiard-nav__ball--active' : '' %>"
              aria-current="<%= item.active ? 'page' : 'false' %>"
            >
              <span class="gm-billiard-nav__number"><%= idx + 1 %></span>
              <span class="gm-billiard-nav__label"><%= item.label %></span>
              <% if (item.badge) { %><span class="gm-billiard-nav__badge" aria-label="<%= item.badge %> pending approvals"><%= item.badge %></span><% } %>
            </a>
          <% }) %>
        </nav>
      <% } %>

      <div class="site-header__actions" aria-label="Session actions">
        <% if (headerBranch) { %>
          <span class="header-branch-badge" id="signed-in-branch" aria-label="Signed-in branch: <%= headerBranch %>" title="Signed-in branch"><%= headerBranch %></span>
        <% } %>
        <div class="site-header__session-btns">
          <div class="site-header__btn-row">
            <button type="button" id="fullscreen-toggle" class="btn btn-fullscreen">Full Screen</button>
            <%- include('theme-toggle') %>
          </div>
          <% if (currentUser) { %>
            <form method="post" action="/auth/logout" class="header-logout-form">
              <button type="submit" class="btn btn-fullscreen">Log Out</button>
            </form>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="site-header__logo-wrap">
        <h1>
          <a href="/" class="brand-heading" aria-label="Return to main page" title="Return to main page">
            <span class="brand-text">
              <span class="brand-text__name">A&amp;E Auto Service</span>
              <span class="brand-text__entity">GROUP INC.</span>
            </span>
          </a>
        </h1>
        <% if (!isHomePage) { %>
          <%- include('back-button', { backChipMode: 'under-logo' }) %>
        <% } %>
      </div>
      <nav>
        <% if (headerBranch) { %>
          <span class="header-branch-badge" id="signed-in-branch" aria-label="Signed-in branch: <%= headerBranch %>" title="Signed-in branch"><%= headerBranch %></span>
        <% } %>
        <% if (activeRole === 'technician') { %>
          <a href="/technician">Technician</a>
        <% } else if (activeRole === 'service_technical_manager') { %>
          <a href="/stm">STM Dashboard</a>
          <a href="/service">Service Portal</a>
          <a href="/gm/fte" class="<%= pathNow === '/gm/fte' ? 'nav-link--active' : '' %>">FTE Tracking</a>
        <% } else if (activeRole === 'admin') { %>
          <a href="/admin">Finance Office</a>
          <a href="/gm/fte" class="<%= pathNow === '/gm/fte' ? 'nav-link--active' : '' %>">Assets &amp; Facilities</a>
          <a href="/finance">Accounting</a>
          <a href="/admin/gates/removed-records">Removed Records</a>
        <% } else if (['hr', 'hr_manager', 'hr_generalist', 'payroll', 'hr_clerk'].includes(activeRole)) { %>
        <% } else if (['service_receptionist', 'senior_service_receptionist', 'service_advisor'].includes(activeRole)) { %>
          <a href="/service-receptionist" class="<%= pathNow.indexOf('/service-receptionist') === 0 ? 'nav-link--active' : '' %>"><%= roleLabel %> Dashboard</a>
          <a href="/service">Service Portal</a>
        <% } else if (activeRole === 'parts_clerk') { %>
          <a href="/parts-portal">Parts Portal</a>
        <% } else if (['operations_manager', 'store_manager', 'cashier', 'stores_clerk'].includes(activeRole)) { %>
          <a href="/stores">Stores Portal</a>
        <% } %>
        <% if (activeRole === 'admin') { %>
          <a href="/employees">Employee DB</a>
        <% } %>
        <% if (!['hr', 'hr_manager', 'hr_generalist', 'payroll', 'hr_clerk'].includes(activeRole)) { %>
          <% if (canApproveRequests) { %>
            <a href="/approvals" class="approval-nav <%= pendingApprovalCount > 0 ? 'approval-nav--pending' : '' %>" title="Approval requests">
              Approvals<% if (pendingApprovalCount > 0) { %> <span class="approval-nav__count"><%= pendingApprovalCount %></span><% } %>
            </a>
          <% } else if (currentUser) { %>
            <a href="/approvals<%= typeof myTickets !== 'undefined' && myTickets.length ? '#my-tickets' : '' %>" class="approval-nav<%= typeof myTickets !== 'undefined' && myTickets.length ? ' approval-nav--pending' : '' %>" title="Submit or view approval requests and decided tickets">
              Requests<% if (typeof myTickets !== 'undefined' && myTickets.length) { %> <span class="approval-nav__count"><%= myTickets.length %></span><% } %>
            </a>
          <% } %>
        <% } %>
        <% if (typeof canCreatePo !== 'undefined' && canCreatePo) { %>
          <a href="/po/create" class="<%= pathNow.indexOf('/po/create') === 0 ? 'nav-link--active' : '' %>">Create PO</a>
        <% } %>
        <% if (typeof isPoApprover !== 'undefined' && (isPoApprover || canManagePo)) { %>
          <a href="/po/approvals" class="approval-nav <%= poPendingCount > 0 ? 'approval-nav--pending' : '' %>">PO Approvals<% if (poPendingCount > 0) { %> <span class="approval-nav__count"><%= poPendingCount %></span><% } %></a>
        <% } %>
        <% if (typeof canManagePo !== 'undefined' && canManagePo) { %>
          <a href="/po/settings">PO Settings</a>
        <% } %>
        <% if (currentUser) { %>
          <span class="header-user-badge"><%= roleLabel %>: <%= currentUser.username %><%= ['service_receptionist', 'senior_service_receptionist', 'service_advisor'].includes(activeRole) && currentUser.branch ? ` | ${currentUser.branch}` : '' %></span>
        <% } %>
        <% if (!['hr', 'hr_manager', 'hr_generalist', 'payroll', 'hr_clerk'].includes(activeRole)) { %>
          <button type="button" id="fullscreen-toggle" class="btn btn-fullscreen">Full Screen</button>
        <% } %>
        <%- include('theme-toggle') %>
        <% if (currentUser) { %>
          <form method="post" action="/auth/logout" class="header-logout-form">
            <button type="submit" class="btn btn-fullscreen">Log Out</button>
          </form>
        <% } %>
      </nav>
    <% } %>
  </header>
  <% const sidebarEligible = !!currentUser && pathNow.indexOf('/auth') !== 0; %>
  <% const showPmSidebar = sidebarEligible && isPmRole; %>
  <% const isFrontlineSvcRole = ['service_advisor', 'service_receptionist', 'senior_service_receptionist'].includes(activeRole); %>
  <% const showGmSidebar = false; %>
  <% const showStmSidebar = sidebarEligible && !showGmSidebar && !showPmSidebar && activeRole === 'service_technical_manager'; %>
  <% const showHrSidebar = sidebarEligible && !showGmSidebar && (isHrRole || (activeRole === 'admin' && /^\/hr(\/|$)/.test(pathNow))); %>
  <% const showFinanceSidebar = sidebarEligible && !showGmSidebar && (isFmRole || (activeRole === 'admin' && /^\/finance(\/|$)/.test(pathNow))); %>
  <% const showAdminSidebar = sidebarEligible && activeRole === 'admin' && !showFinanceSidebar && !showHrSidebar; %>
  <% const showServiceSidebar = sidebarEligible && !showPmSidebar && !showGmSidebar && !showStmSidebar && !showAdminSidebar && !showFinanceSidebar && !showHrSidebar && (isFrontlineSvcRole || /^\/service(-receptionist)?(\/|$)/.test(pathNow)); %>
  <% const anySidebar = showPmSidebar || showGmSidebar || showStmSidebar || showServiceSidebar || showAdminSidebar || showFinanceSidebar || showHrSidebar; %>
  <% if (showPmSidebar) { %><%- include('pm-sidebar') %><% } %>
  <% if (showGmSidebar) { %><%- include('gm-sidebar') %><% } %>
  <% if (showStmSidebar) { %><%- include('stm-sidebar') %><% } %>
  <% if (showAdminSidebar) { %><%- include('admin-sidebar') %><% } %>
  <% if (showFinanceSidebar) { %><%- include('finance-sidebar') %><% } %>
  <% if (showHrSidebar) { %><%- include('hr-sidebar') %><% } %>
  <% if (showServiceSidebar) { %><%- include('service-sidebar') %><% } %>
  <% if (anySidebar) { %><%- include('sidebar-toggle') %><% } %>
  <main class="container<%= anySidebar ? ' container--pm-sidebar' : '' %>">
    <% if (typeof globalError !== 'undefined' && globalError) { %>
      <p class="error global-error-message"><%= globalError %></p>
    <% } %>
