<%- include('../partials/header') %>
<%
  function fmtMoney(value) {
    return '₱' + Number(value || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function fmtPct(value) {
    return Number(value || 0).toFixed(1) + '%';
  }
  function fmtHours(value) {
    return Number(value || 0).toFixed(2);
  }
  const v = (typeof vitals !== 'undefined' && vitals) ? vitals : {};
  const bars = (typeof pacingBars !== 'undefined' && pacingBars) ? pacingBars : { bars: [] };
  const barByKey = {};
  (bars.bars || []).forEach((bar) => { if (bar && bar.key) barByKey[bar.key] = bar; });
  const mtdGross = barByKey.gross && barByKey.gross.valueText
    ? barByKey.gross.valueText
    : fmtMoney(0);
  const pacingHealth = barByKey.pacing && barByKey.pacing.valueText
    ? barByKey.pacing.valueText
    : fmtPct(0);
  const branchList = Array.isArray(branches) ? branches : [];
  const managerName = String((currentUser && (currentUser.username || currentUser.employee_id)) || 'Manager').trim() || 'Manager';
  const approvalCount = typeof pendingApprovalCount !== 'undefined' ? Number(pendingApprovalCount || 0) : 0;
%>

<section class="dashboard-shell stm-landing" id="stm-landing">
  <div class="stm-landing__top">
    <div class="dashboard-title gm-title role-dashboard-title stm-landing__title">
      <span>STM</span> <span class="role-dashboard-title__suffix">Portal Dashboard</span>
    </div>
    <div class="stm-landing__top-actions">
      <label class="stm-branch-filter stm-landing__branch">
        <span class="stm-landing__sr">Branch view</span>
        <select id="stm-landing-branch" aria-label="All Branches">
          <option value="ALL">All Branches</option>
          <% branchList.forEach((name) => { %>
            <option value="<%= name %>"><%= name %></option>
          <% }) %>
        </select>
      </label>
      <a class="stm-landing__bell<%= approvalCount > 0 ? ' is-pending' : '' %>" href="/approvals" title="Approvals">
        <span aria-hidden="true">🔔</span>
        <% if (approvalCount > 0) { %><span class="stm-landing__bell-count"><%= approvalCount %></span><% } %>
        <span class="stm-landing__sr">Approvals</span>
      </a>
    </div>
  </div>

  <div class="stm-landing__grid">
    <aside class="stm-landing__nav" aria-label="STM portal menu">
      <section class="stm-landing-nav-group">
        <h3 class="stm-landing-nav-group__title">🛠️ Quick Actions</h3>
        <a class="stm-landing-nav-btn stm-landing-nav-btn--primary" href="/work-orders/new">+ New Work Order</a>
        <a class="stm-landing-nav-btn" href="/customers">Customer Lookup</a>
      </section>

      <section class="stm-landing-nav-group">
        <h3 class="stm-landing-nav-group__title">📋 Advisor Tools</h3>
        <a href="/work-orders">Active Estimates</a>
        <a href="/approvals">Pending Approvals<% if (approvalCount > 0) { %> (<%= approvalCount %>)<% } %></a>
      </section>

      <section class="stm-landing-nav-group">
        <h3 class="stm-landing-nav-group__title">⚙️ Workshop Mgmt</h3>
        <a href="/work-orders">Dispatch Board</a>
        <a href="/work-order-transactions/technicians">Tech Activities</a>
        <a href="/parts">Inventory / Parts</a>
        <a class="stm-landing-nav-btn stm-landing-nav-btn--monitor" href="/stm/monitor">STM Monitor</a>
      </section>

      <section class="stm-landing-nav-group">
        <h3 class="stm-landing-nav-group__title">📊 Analytics</h3>
        <a href="/kpi">Sales Reports</a>
        <a href="/kpi">Branch Metrics</a>
      </section>
    </aside>

    <div class="stm-landing__main">
      <p class="stm-landing__welcome">Welcome back, <%= managerName %>. Here is your workshop status today:</p>

      <div class="stm-landing__cards">
        <article class="dashboard-card gm-panel stm-landing-card">
          <div class="dashboard-card__header gm-panel-header">📊 Revenue &amp; Pacing</div>
          <ul class="stm-landing-card__list">
            <li>MTD Total Gross: <strong><%= mtdGross %></strong></li>
            <li>Pacing Health: <strong><%= pacingHealth %></strong></li>
          </ul>
          <a class="stm-landing-card__link" href="/kpi">View Financial Portal →</a>
        </article>

        <article class="dashboard-card gm-panel stm-landing-card">
          <div class="dashboard-card__header gm-panel-header">🔧 Live Workshop Command</div>
          <ul class="stm-landing-card__list">
            <li>Open WOs: <strong><%= v.openRoCount || 0 %></strong></li>
            <li>Unassigned &gt;10m: <strong><%= v.unassignedOverdue || 0 %></strong></li>
          </ul>
          <a class="stm-landing-card__link" href="/work-orders">Go to Dispatch Board →</a>
        </article>

        <article class="dashboard-card gm-panel stm-landing-card">
          <div class="dashboard-card__header gm-panel-header">👥 Technician Performance</div>
          <ul class="stm-landing-card__list">
            <li>Avg Efficiency: <strong><%= fmtPct(v.technicianEfficiencyPct) %></strong></li>
            <li>Avg TAT: <strong><%= fmtHours(v.serviceTurnaroundHoursAvg) %>h</strong></li>
          </ul>
          <a class="stm-landing-card__link" href="/stm/monitor">View Tech Metrics →</a>
        </article>

        <article class="dashboard-card gm-panel stm-landing-card">
          <div class="dashboard-card__header gm-panel-header">📑 Billing &amp; Backlog</div>
          <ul class="stm-landing-card__list">
            <li>Pending Billing: <strong><%= v.pendingBillingCount || 0 %></strong></li>
            <li>Comeback Rate: <strong><%= fmtPct(v.comebackRatePct) %></strong></li>
          </ul>
          <a class="stm-landing-card__link" href="/transactions">Open Billing Queue →</a>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  (function bindStmLandingBranch() {
    const select = document.getElementById('stm-landing-branch');
    if (!select) return;
    select.addEventListener('change', function onBranchChange() {
      const value = String(select.value || 'ALL');
      window.location.href = '/stm/monitor?branch=' + encodeURIComponent(value === 'ALL' ? 'all' : value);
    });
  })();
</script>

<%- include('../partials/footer') %>
