<%- include('partials/header') %>

<section class="dashboard-shell admin-shell sa-shell">
  <% const dashRole = String((typeof roleLabel !== 'undefined' && roleLabel) || (currentUser && currentUser.role) || '').toLowerCase(); %>
  <% const dashLabel = dashRole === 'sa' || dashRole === 'service_advisor' ? 'SA' : (dashRole === 'ssr' || dashRole === 'senior_service_receptionist' ? 'SSR' : (dashRole === 'sr' || dashRole === 'service_receptionist' ? 'SR' : (String((typeof roleLabel !== 'undefined' && roleLabel) || 'SA').toUpperCase()))); %>
  <div class="dashboard-title admin-title sa-title role-dashboard-title"><span><%= dashLabel %> <%= branch %></span> <span class="role-dashboard-title__suffix">Dashboard</span></div>
  <% const safeTechStats = (typeof technicianStats !== 'undefined' && technicianStats) ? technicianStats : []; %>
  <div class="sa-grid sa-grid--4">
    <article class="gm-kpi-card sa-card">
      <div class="sa-card-title">TRANSACTIONS</div>
      <div class="sa-card-body">
        <p class="sa-line"><strong>Open Work Orders:</strong> [<%= work_orders.length %>] <span class="dashboard-status">[↑ Active]</span></p>
        <p class="sa-line">Customers: [<%= customers.length %>] | Vehicles: [<%= vehicles.length %>] <span class="dashboard-status">[→ Active]</span></p>
      </div>
      <div class="sa-open-row">
        <a class="btn" href="/work-order-transactions" aria-label="Open Transactions">OPEN</a>
      </div>
    </article>

    <article class="gm-kpi-card sa-card">
      <div class="sa-card-title">PARTS</div>
      <div class="sa-card-body">
        <p class="sa-line"><%= branch || 'Your branch' %> parts database and transactions</p>
        <p class="sa-line">Default view is this branch only. <span class="dashboard-status">[Updated just now]</span></p>
      </div>
      <div class="sa-open-row">
        <a class="btn" href="/parts">ACCESS DATABASE</a>
      </div>
    </article>

    <article class="gm-kpi-card sa-card">
      <div class="sa-card-title">CREATE PARTS</div>
      <div class="sa-card-body">
        <p class="sa-line">Create a part for all branches with date and branch</p>
        <p class="sa-line">Saves stock at your branch; Warehouse 1 / PM log the transaction <span class="dashboard-status">[Live]</span></p>
      </div>
      <div class="sa-open-row">
        <a class="btn" href="/parts/create" aria-label="Create Parts">OPEN</a>
      </div>
    </article>

    <article class="gm-kpi-card sa-card">
      <div class="sa-card-title">WAREHOUSE 1</div>
      <div class="sa-card-body">
        <p class="sa-line">View Warehouse 1 parts database and transactions</p>
        <p class="sa-line">Read-only lookup for warehouse stock</p>
      </div>
      <div class="sa-open-row">
        <a class="btn" href="/parts?scope=warehouse1">VIEW WAREHOUSE 1</a>
      </div>
    </article>

    <article class="gm-kpi-card sa-card">
      <div class="sa-card-title">HELPER</div>
      <div class="sa-card-body">
        <p class="sa-line">Search Parts, Customer Info, Technicians, &amp; App Data.</p>
        <p class="sa-line">Integrated Helpdesk &amp; KB.</p>
      </div>
      <div class="sa-open-row">
        <a class="btn" href="/helper">SEARCH/OPEN</a>
      </div>
    </article>

    <article class="gm-kpi-card sa-card">
      <div class="sa-card-title">BRANCH PARTS DB</div>
      <div class="sa-card-body">
        <p class="sa-line">This branch Parts Database, low-stock monitor, Warehouse 1 orders</p>
        <p class="sa-line">Save drafts · Send to Parts Manager</p>
      </div>
      <div class="sa-open-row">
        <a class="btn" href="/branch-parts" aria-label="Open Branch Parts DB">OPEN PANEL</a>
      </div>
    </article>
    <article class="gm-kpi-card sa-card">
      <div class="sa-card-title">FTE WORKSPACE</div>
      <div class="sa-card-body">
        <p class="sa-line">Transaction &amp; Record Center</p>
        <p class="sa-line">Real-time Branch Logging: <strong>[CebuCity]</strong></p>
      </div>
      <div class="sa-open-row">
        <a class="btn" href="/gm/fte" aria-label="Open FTE Tracking Panel">OPEN PANEL</a>
      </div>
    </article>
  </div>

  <article class="dashboard-card admin-panel sa-tech-panel sa-tech-panel--fill">
    <div class="dashboard-card__header admin-panel-header">TECHNICIAN</div>
    <p class="dashboard-note admin-note">Live Technician Summary &amp; MTD Performance Metrics.</p>
    <% if (!safeTechStats.length) { %>
      <p class="dashboard-note admin-note">[Graph placeholder: Top Techs | Total Hours Billed: 1,450 | Avg Efficiency: 92%]</p>
    <% } else { %>
      <div class="table-scroll sa-tech-panel__scroll">
        <table class="list">
          <thead>
            <tr>
              <th>Technician</th>
              <th>Assigned Car (Current)</th>
              <th>Time Spent (Present Job)</th>
              <th>Total Labor (Accumulated)</th>
              <th>Total Labor Price MTD</th>
              <th>Work Orders Handled MTD</th>
            </tr>
          </thead>
          <tbody>
            <% safeTechStats.forEach(stat => { %>
              <tr>
                <td><%= stat.technician %></td>
                <td><%= stat.current_car %></td>
                <td><%= stat.current_job_time %></td>
                <td>₱<%= Number(stat.total_labor_accumulated || 0).toFixed(2) %></td>
                <td>₱<%= Number(stat.total_labor_mtd || 0).toFixed(2) %></td>
                <td><%= stat.work_orders_mtd %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </article>
</section>

<%- include('partials/footer') %>
