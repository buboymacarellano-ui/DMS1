<%- include('partials/header') %>

<section class="dashboard-shell admin-shell sa-shell" id="service-portal-home">
  <% const revenueBars = (typeof branchRevenueBars !== 'undefined' && branchRevenueBars) ? branchRevenueBars : { bars: [], monthLabel: '', branch: branch }; %>

  <section class="sa-home-group sa-mtd-group" id="sa-mtd-bars" aria-label="Branch sales report">
    <h3 class="sa-home-group__title">Sales Report · <%= revenueBars.monthLabel || 'This month' %> · <%= revenueBars.branch || branch %></h3>
    <div class="sa-mtd-bars">
      <% (revenueBars.bars || []).forEach((bar) => { %>
        <article class="sa-mtd-bar sa-mtd-bar--<%= bar.tone %>" data-key="<%= bar.key %>" data-fill="<%= bar.fillPct %>" data-tone="<%= bar.tone %>">
          <p class="sa-mtd-bar__label"><%= bar.label %></p>
          <p class="sa-mtd-bar__value"><%= bar.valueText %></p>
          <div
            class="sa-mtd-bar__track"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="<%= bar.fillPct %>"
            aria-label="<%= bar.label %>"
          >
            <span class="sa-mtd-bar__fill"></span>
          </div>
          <p class="sa-mtd-bar__meta"><%= bar.meta %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <%
    const salesRows = (typeof salesReportRows !== 'undefined' && salesReportRows) ? salesReportRows : [];
    const salesSummary = (typeof salesReportSummary !== 'undefined' && salesReportSummary)
      ? salesReportSummary
      : { count: 0, laborTotal: 0, partsTotal: 0, grandTotal: 0 };
    const peso = (value) => '₱' + Number(value || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  %>
  <section class="sa-home-group sales-report-group" id="sales-report-database" aria-label="Sales report database">
    <div class="stm-section__title-row">
      <h3 class="sa-home-group__title">Sales Report Database · Closed Work Orders Converted to Sales</h3>
      <p class="dashboard-note stm-section__note">Branch: <%= branch %> &middot; <%= salesSummary.count %> invoiced sale(s)</p>
    </div>

    <div class="sales-report-summary">
      <article class="sales-report-summary__card">
        <p class="sales-report-summary__label">Total Sales (Invoices)</p>
        <p class="sales-report-summary__value"><%= salesSummary.count %></p>
      </article>
      <article class="sales-report-summary__card">
        <p class="sales-report-summary__label">Total Labor Revenue</p>
        <p class="sales-report-summary__value"><%= peso(salesSummary.laborTotal) %></p>
      </article>
      <article class="sales-report-summary__card">
        <p class="sales-report-summary__label">Total Parts Revenue</p>
        <p class="sales-report-summary__value"><%= peso(salesSummary.partsTotal) %></p>
      </article>
      <article class="sales-report-summary__card sales-report-summary__card--gross">
        <p class="sales-report-summary__label">Total Grand Revenue (w/ VAT)</p>
        <p class="sales-report-summary__value"><%= peso(salesSummary.grandTotal) %></p>
      </article>
    </div>

    <div class="sales-report-toolbar">
      <input
        type="text"
        id="sales-report-search"
        class="sales-report-toolbar__input"
        placeholder="Search invoice #, customer, plate, technician, service, part..."
        aria-label="Search sales report database"
      >
    </div>

    <div class="table-scroll transaction-table-wrap">
      <table class="list transaction-table sales-report-table" id="sales-report-table">
        <thead>
          <tr>
            <th class="sticky-col sticky-col-1">Invoice #</th>
            <th class="sticky-col sticky-col-2">Invoiced Date</th>
            <th>Br. Loc</th>
            <th>Work Order #</th>
            <th>Customer Name</th>
            <th>Contact Number</th>
            <th>Vehicle Brand</th>
            <th>Vehicle Model</th>
            <th>Year</th>
            <th>Plate Number</th>
            <th>Odometer</th>
            <th>Service Advisor</th>
            <th>Technician</th>
            <th>Date Opened</th>
            <th>Time In</th>
            <th>Time Out</th>
            <th>Services Rendered</th>
            <th>Services Count</th>
            <th>Parts Used</th>
            <th>Parts Count</th>
            <th>Labor Total</th>
            <th>Parts Total</th>
            <th>Subtotal</th>
            <th>VAT (12%)</th>
            <th>Grand Total</th>
            <th>Payment Method</th>
            <th>Payment Status</th>
            <th>Balance Due</th>
          </tr>
        </thead>
        <tbody>
          <% if (!salesRows.length) { %>
            <tr>
              <td colspan="28" class="sales-report-empty">No closed work orders have been converted into sales yet for this branch.</td>
            </tr>
          <% } %>
          <% salesRows.forEach((row) => { %>
            <tr>
              <td class="sticky-col sticky-col-1 sales-report-invoice-cell">
                <a
                  class="sales-report-invoice__trigger"
                  href="/work-orders/<%= encodeURIComponent(row.id) %>/billing"
                  target="_blank"
                  rel="noopener"
                ><%= row.invoice_number %></a>
              </td>
              <td class="sticky-col sticky-col-2"><%= row.invoice_date %></td>
              <td><%= row.branch %></td>
              <td><%= row.work_order_number %></td>
              <td><%= row.customer_name %></td>
              <td><%= row.telephone_number %></td>
              <td><%= row.car_brand %></td>
              <td><%= row.car_model %></td>
              <td><%= row.car_year %></td>
              <td><%= row.plate_number %></td>
              <td><%= row.odometer %></td>
              <td><%= row.service_advisor %></td>
              <td><%= row.technician %></td>
              <td><%= row.date_opened %></td>
              <td><%= row.time_in %></td>
              <td><%= row.time_out %></td>
              <td><%= row.services_rendered %></td>
              <td><%= row.services_count %></td>
              <td><%= row.parts_used %></td>
              <td><%= row.parts_count %></td>
              <td><%= peso(row.labor_total) %></td>
              <td><%= peso(row.parts_total) %></td>
              <td><%= peso(row.subtotal) %></td>
              <td><%= peso(row.vat) %></td>
              <td><%= peso(row.grand_total) %></td>
              <td><%= row.payment_method %></td>
              <td><%= row.payment_status %></td>
              <td><%= peso(row.balance_due) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </section>

</section>

<script src="/js/sa-revenue-bars.js"></script>
<script src="/js/sales-report-search.js"></script>
<%- include('partials/sa-reminder') %>
<%- include('partials/footer') %>
