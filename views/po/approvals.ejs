<%- include('../partials/header') %>
<% function poTable(rows, STATUS_LABELS) { %>
  <% if (!rows.length) { %>
    <p class="dashboard-note admin-note">None.</p>
  <% } else { %>
    <div class="table-scroll">
      <table class="list">
        <thead><tr><th>PO No.</th><th>Date</th><th>Supplier</th><th>Department</th><th>Total</th><th>Status</th><th>Requestor</th></tr></thead>
        <tbody>
          <% rows.forEach((order) => { %>
            <tr>
              <td><a href="/po/<%= order.id %>"><%= order.po_number %></a></td>
              <td><%= order.po_date %></td>
              <td><%= order.supplier %></td>
              <td><%= order.department %></td>
              <td><%= order.currency %> <%= Number(order.grand_total || 0).toFixed(2) %></td>
              <td><%= STATUS_LABELS[order.status] || order.status %></td>
              <td><%= order.created_by %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
<% } %>

<section class="dashboard-shell admin-shell">
  <div class="dashboard-title admin-title role-dashboard-title">PO Approvals</div>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <% if (success) { %><p class="success"><%= success %></p><% } %>

  <article class="dashboard-card admin-panel">
    <div class="dashboard-card__header admin-panel-header">Pending My Approval</div>
    <% poTable(awaiting, STATUS_LABELS) %>
  </article>
  <article class="dashboard-card admin-panel">
    <div class="dashboard-card__header admin-panel-header">My Decisions</div>
    <% poTable(decided, STATUS_LABELS) %>
  </article>
  <% if (canManagePo) { %>
    <article class="dashboard-card admin-panel">
      <div class="dashboard-card__header admin-panel-header">All POs (GM)</div>
      <% poTable(all, STATUS_LABELS) %>
    </article>
  <% } %>
</section>

<%- include('../partials/footer') %>
