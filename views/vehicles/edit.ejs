<%- include('../partials/header') %>

<h2>Edit Vehicle</h2>

<form method="post" action="/vehicles/<%= vehicle.id %>/edit" class="form">
  <label>Customer
    <select name="customer_id" required>
      <option value="">--select--</option>
      <% customers.forEach(c => { %>
        <option value="<%= c.id %>" <%= c.id === vehicle.customer_id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
  </label>
  <label>Make <input name="make" value="<%= vehicle.make %>"></label>
  <label>Model <input name="model" value="<%= vehicle.model %>"></label>
  <label>Year <input name="year" type="number" value="<%= vehicle.year %>"></label>
  <label>Unit Type
    <select name="vehicle_type">
      <option value="small" <%= vehicle.vehicle_type === 'small' ? 'selected' : '' %>>Small</option>
      <option value="medium" <%= vehicle.vehicle_type === 'medium' ? 'selected' : '' %>>Medium</option>
      <option value="compactSuv" <%= vehicle.vehicle_type === 'compactSuv' ? 'selected' : '' %>>Compact SUV</option>
      <option value="suvVanPickUp" <%= vehicle.vehicle_type === 'suvVanPickUp' ? 'selected' : '' %>>SUV / Van / Pickup</option>
      <option value="largeUnit" <%= vehicle.vehicle_type === 'largeUnit' ? 'selected' : '' %>>Large Unit</option>
      <option value="equipment" <%= vehicle.vehicle_type === 'equipment' ? 'selected' : '' %>>Equipment</option>
      <option value="facility" <%= vehicle.vehicle_type === 'facility' ? 'selected' : '' %>>Facility</option>
      <option value="tools" <%= vehicle.vehicle_type === 'tools' ? 'selected' : '' %>>Tools</option>
    </select>
  </label>
  <label>VIN <input name="vin" value="<%= vehicle.vin %>"></label>
  <label>License plate <input name="license_plate" value="<%= vehicle.license_plate %>"></label>
  <button type="submit">Save</button>
  <a href="/vehicles">Cancel</a>
</form>

<%- include('../partials/footer') %>
