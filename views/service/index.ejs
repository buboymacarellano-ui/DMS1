<%- include('../partials/header') %>

<section class="dashboard-shell admin-shell sa-shell" id="service-portal-home">
  <div class="dashboard-title admin-title sa-title role-dashboard-title"><span>Service</span> <span class="role-dashboard-title__suffix">Portal</span></div>
  <p class="dashboard-note">Work orders, seven service bays, and technician scheduling. Existing boards and metrics are unchanged.</p>

  <section class="sa-home-group">
    <h3 class="sa-home-group__title">System Status</h3>
    <div class="sa-grid sa-grid--4">
      <div class="workorder-nav-card sa-home-card" id="db-health-card" style="border-left:4px solid #27ae60;">
        <div class="workorder-nav-card__icon" id="db-health-icon">&mdash;</div>
        <div class="workorder-nav-card__body">
          <strong>Database Health</strong>
          <div id="db-health-percent">&mdash;</div>
          <div id="db-health-message">&mdash;</div>
          <small>Response: <span id="db-health-time">&mdash;</span> ms</small><br>
          <small>Updated: <span id="db-health-updated">&mdash;</span></small>
        </div>
      </div>
    </div>
  </section>

  <section class="sa-home-group">
    <h3 class="sa-home-group__title">1. Work Orders</h3>
    <div class="sa-grid sa-grid--4">
      <% if (canGrant('service', 'view') || canGrant('service', 'access')) { %>
        <a class="workorder-nav-card workorder-nav-card--blue sa-home-card sa-home-card--kpi" href="/work-orders">
          <div class="workorder-nav-card__icon">&#9881;</div>
          <div class="workorder-nav-card__body">
            <h3>Work Orders</h3>
            <p><%= openWorkOrdersCount || 0 %></p>
            <span>Open list</span>
          </div>
        </a>
      <% } %>
      <% if (canGrant('service', 'filloutform') || canGrant('service', 'edit')) { %>
        <a class="workorder-nav-card workorder-nav-card--orange sa-home-card" href="/work-orders/new">
          <div class="workorder-nav-card__icon">&#10010;</div>
          <div class="workorder-nav-card__body">
            <h3>New Work Order</h3>
            <p>Create a job</p>
            <span>Fill-out form</span>
          </div>
        </a>
      <% } %>
      <a class="workorder-nav-card workorder-nav-card--yellow sa-home-card sa-home-card--kpi" href="/customers">
        <div class="workorder-nav-card__icon">&#128101;</div>
        <div class="workorder-nav-card__body">
          <h3>Customers</h3>
          <p><%= customerCount || 0 %></p>
          <span>Directory</span>
        </div>
      </a>
      <a class="workorder-nav-card workorder-nav-card--green sa-home-card" href="/work-order-transactions">
        <div class="workorder-nav-card__icon">📊</div>
        <div class="workorder-nav-card__body">
          <h3>WO Transactions Database</h3>
          <p>All records</p>
          <span>Billing · History</span>
        </div>
      </a>
    </div>
  </section>

  <section class="sa-home-group">
    <h3 class="sa-home-group__title">2. Seven Service Bays</h3>
    <div class="sa-grid sa-grid--4">
      <a class="workorder-nav-card workorder-nav-card--blue sa-home-card" href="<%= (typeof canGrant === 'function' && (canGrant('service', 'schedule') || canGrant('service', 'approval'))) ? '/stm[...]
        <div class="workorder-nav-card__icon">&#128736;</div>
        <div class="workorder-nav-card__body">
          <h3>Bay Monitor</h3>
          <p>Live floor</p>
          <span>7 branches</span>
        </div>
      </a>
      <a class="workorder-nav-card workorder-nav-card--blue sa-home-card" href="/service-receptionist">
        <div class="workorder-nav-card__icon">&#127970;</div>
        <div class="workorder-nav-card__body">
          <h3>Branch Dashboard</h3>
          <p>SA / SR / SSR</p>
          <span>Assigned bay</span>
        </div>
      </a>
      <a class="workorder-nav-card workorder-nav-card--orange sa-home-card" href="/gm/fte">
        <div class="workorder-nav-card__icon">&#128736;</div>
        <div class="workorder-nav-card__body">
          <h3>FTE Workspace</h3>
          <p>Facility issues</p>
          <span>Records</span>
        </div>
      </a>
    </div>
  </section>

  <section class="sa-home-group">
    <h3 class="sa-home-group__title">3. Tech Scheduling</h3>
    <div class="sa-grid sa-grid--4">
      <a class="workorder-nav-card workorder-nav-card--blue sa-home-card sa-home-card--kpi" href="/work-order-transactions/technicians">
        <div class="workorder-nav-card__icon">&#128295;</div>
        <div class="workorder-nav-card__body">
          <h3>Technicians</h3>
          <p><%= technicianCount || 0 %></p>
          <span>Status · assignments</span>
        </div>
      </a>
      <% if (canGrant('service', 'schedule') || canGrant('service', 'assign_tech')) { %>
        <a class="workorder-nav-card workorder-nav-card--yellow sa-home-card" href="/stm">
          <div class="workorder-nav-card__icon">&#128197;</div>
          <div class="workorder-nav-card__body">
            <h3>Scheduling Board</h3>
            <p>Live assignments</p>
            <span>STM monitor</span>
          </div>
        </a>
      <% } %>
    </div>
  </section>

  <section class="sa-home-group">
    <h3 class="sa-home-group__title">4. Receiving</h3>
    <div class="sa-grid sa-grid--4">
      <% if (canGrant('parts', 'request')) { %>
        <a class="workorder-nav-card workorder-nav-card--orange sa-home-card" href="/parts#approved-transfers">
          <div class="workorder-nav-card__icon">&#128230;</div>
          <div class="workorder-nav-card__body">
            <h3>Parts Receiving</h3>
            <p>Verify approved transfers</p>
            <span>Update branch stock</span>
          </div>
        </a>
      <% } %>
      <a class="workorder-nav-card workorder-nav-card--blue sa-home-card sa-home-card--kpi" href="/receiving">
        <div class="workorder-nav-card__icon">📦</div>
        <div class="workorder-nav-card__body">
          <h3>Receiving Transactions</h3>
          <p><%= receivingCount || 0 %></p>
          <span>Approve & restock</span>
        </div>
      </a>
    </div>
  </section>
</section>

<script>
(function () {
  var COLORS = { healthy: '#27ae60', degraded: '#f39c12', error: '#e74c3c' };
  var ICONS = { healthy: '✓', degraded: '⚠', error: '✕' };
  function set(id, v) { document.getElementById(id).textContent = v; }
  function render(d) {
    var st = d && COLORS[d.status] ? d.status : 'error';
    document.getElementById('db-health-card').style.borderLeft = '4px solid ' + COLORS[st];
    set('db-health-icon', ICONS[st]);
    set('db-health-percent', d && d.healthPercentage != null ? d.healthPercentage + '%' : '—');
    set('db-health-message', d && d.message ? d.message : '—');
    set('db-health-time', d && d.responseTime != null ? d.responseTime : '—');
    set('db-health-updated', d && d.timestamp
      ? new Date(d.timestamp).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : '—');
  }
  function refresh() {
    fetch('/api/health/database', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(render)
      .catch(function () { render(null); });
  }
  refresh();
  setInterval(refresh, 30000);
})();
</script>

<%- include('../partials/footer') %>
