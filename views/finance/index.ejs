<%- include('../partials/header') %>
<%
  function fmtMoney(value) {
    return 'â‚±' + Number(value || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  const m = (typeof metrics !== 'undefined' && metrics) ? metrics : { grossRevenue: 0, netProfit: 0, outstandingReceivables: 0 };
  const matrix = Array.isArray(paymentMatrix) ? paymentMatrix : [];
  const arRows = Array.isArray(receivables) ? receivables : [];
  const dayRows = Array.isArray(dailyRows) ? dailyRows : [];
  const dateValue = typeof reportingDate !== 'undefined' ? reportingDate : '';
%>

<section class="dashboard-shell admin-shell fm-workspace" id="fm-workspace" data-reporting-date="<%= dateValue %>">
  <div class="fm-head">
    <div class="dashboard-title admin-title role-dashboard-title"><span>Finance</span> <span class="role-dashboard-title__suffix">Dashboard</span></div>
    <form method="get" action="/finance" class="fm-date-filter">
      <span>Reporting Date</span>
      <input type="date" name="date" value="<%= dateValue %>" aria-label="Reporting date" />
      <button type="submit" class="btn">Apply</button>
      <a class="btn" href="/api/finance/eod-report?date=<%= encodeURIComponent(dateValue) %>" target="_blank" rel="noopener">Print EOD drawer</a>
    </form>
  </div>

  <section class="fm-metrics" aria-label="Core finance balances">
    <article class="gm-kpi-card admin-summary-card fm-metric" data-metric="grossRevenue">
      <p class="gm-kpi-label">Gross Revenue</p>
      <h2 class="gm-kpi-value" id="fm-gross-revenue"><%= fmtMoney(m.grossRevenue) %></h2>
      <p class="dashboard-note">Collected invoices (Paid + partial receipts)</p>
    </article>
    <article class="gm-kpi-card admin-summary-card fm-metric" data-metric="netProfit">
      <p class="gm-kpi-label">Net Profit</p>
      <h2 class="gm-kpi-value" id="fm-net-profit"><%= fmtMoney(m.netProfit) %></h2>
      <p class="dashboard-note">Revenue âˆ’ parts cost âˆ’ labor cost</p>
    </article>
    <article class="gm-kpi-card admin-summary-card fm-metric" data-metric="outstandingReceivables">
      <p class="gm-kpi-label">Outstanding Receivables</p>
      <h2 class="gm-kpi-value" id="fm-receivables-total"><%= fmtMoney(m.outstandingReceivables) %></h2>
      <p class="dashboard-note">Unpaid / Account Receivable balances</p>
    </article>
  </section>

</section>

<script src="/js/finance-workspace.js"></script>
<%- include('../partials/footer') %>

