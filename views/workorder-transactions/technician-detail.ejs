<%- include('../partials/header') %>

<section class="dashboard-shell technician-monitor technician-monitor--detail">
  <div class="dashboard-title gm-title">Technician Details</div>
  <p><a class="btn" href="/work-order-transactions/technicians">Back to Technician Grid</a></p>
  <% if (success) { %><p class="success"><%= success %></p><% } %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <% const board = technician.board_status || { label: technician.current_order ? 'On-Going' : 'Idle', tone: technician.current_order ? 'ongoing' : 'idle' }; %>
  <% const present = technician.current_order; %>
  <% const assignedOrders = Array.isArray(technician.assigned_orders) ? technician.assigned_orders : []; %>
  <% const peso = (value) => Number(value || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
  <article class="technician-monitor__card">
    <header>
      <div><h2><%= technician.technician %></h2><p><%= technician.job_title || 'Technician' %> | <%= technician.branch || 'Unassigned branch' %></p></div>
      <span class="technician-monitor__status technician-monitor__status--<%= board.tone %>"><%= board.label %></span>
    </header>

    <div class="technician-monitor__kpis">
      <div><span>Present WO</span><strong><%= present ? present.work_order_number : '—' %></strong></div>
      <div><span>Active WOs</span><strong><%= technician.active_count %></strong></div>
      <div><span>Assigned WOs</span><strong><%= technician.assigned_count || assignedOrders.length %></strong></div>
      <div><span>Completed MTD</span><strong><%= technician.completed_mtd %></strong></div>
      <div><span>Completion Rate</span><strong><%= Number(technician.completion_rate || 0).toFixed(1) %>%</strong></div>
      <div><span>Active Hours</span><strong><%= Number(technician.hours_active || 0).toFixed(1) %>h</strong></div>
      <div><span>Avg Cycle</span><strong><%= Number(technician.average_cycle_hours || 0).toFixed(1) %>h</strong></div>
      <div><span>Present Labor</span><strong>₱<%= peso(technician.labor_present) %></strong></div>
      <div><span>Labor Acc.</span><strong>₱<%= peso(technician.labor_accumulated) %></strong></div>
      <div><span>Labor MTD</span><strong>₱<%= peso(technician.labor_mtd) %></strong></div>
    </div>

    <section class="technician-monitor__current">
      <h3>Present Work Order</h3>
      <% if (!present) { %><p>No active work order assigned.</p><% } else { %>
        <p><strong><a href="/work-orders/<%= present.id %>/edit">WO <%= present.work_order_number %></a></strong> | <%= present.status_label || present.status || '—' %></p>
        <p>Vehicle: <%= present.vehicle || '—' %> | Customer: <%= present.customer || '—' %></p>
        <p><%= present.branch || 'No branch' %> | Time in: <%= present.time_in || '—' %> | <%= Number(present.hours_open || 0).toFixed(1) %> hours since assignment</p>
        <p>Labor ₱<%= peso(present.labor) %> | Parts ₱<%= peso(present.parts) %> | Total ₱<%= peso(present.total) %></p>
        <% if (present.services && present.services.length) { %><p>Services: <%= present.services.join(' · ') %></p><% } %>
        <p>
          <a href="/work-orders/<%= present.id %>/edit">Open Work Order</a>
          · <a href="/work-orders/<%= present.id %>/service">Services</a>
        </p>
      <% } %>
    </section>

    <details open><summary>Assigned Work Orders (<%= assignedOrders.length %>)</summary>
      <% if (!assignedOrders.length) { %><p>No work orders assigned to this technician.</p><% } else { %>
        <div class="table-scroll">
          <table class="list technician-monitor__orders">
            <thead>
              <tr>
                <th>WO</th>
                <th>Status</th>
                <th>Vehicle</th>
                <th>Customer</th>
                <th>Time In</th>
                <th>Hours</th>
                <th>Labor</th>
                <th>Parts</th>
                <th>Total</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% assignedOrders.forEach((order) => { %>
                <tr>
                  <td><a href="/work-orders/<%= order.id %>/edit">WO <%= order.work_order_number %></a></td>
                  <td><%= order.status_label || order.status || '—' %></td>
                  <td><%= order.vehicle || '—' %></td>
                  <td><%= order.customer || '—' %></td>
                  <td><%= order.time_in || '—' %></td>
                  <td><%= Number(order.hours_open || 0).toFixed(1) %>h</td>
                  <td>₱<%= peso(order.labor) %></td>
                  <td>₱<%= peso(order.parts) %></td>
                  <td>₱<%= peso(order.total) %></td>
                  <td>
                    <a href="/work-orders/<%= order.id %>/edit">Edit</a>
                    · <a href="/work-orders/<%= order.id %>/service">Services</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </details>

    <details open><summary>Pending Work Orders (<%= technician.pending_orders.length %>)</summary>
      <% if (!technician.pending_orders.length) { %><p>No other assigned work besides the present job.</p><% } %>
      <% technician.pending_orders.forEach(order => { %><div class="technician-monitor__pending-row"><div><strong><a href="/work-orders/<%= order.id %>/edit">WO <%= order.work_order_number %></a></strong> | <%= order.vehicle || 'Vehicle not recorded' %></div><div><%= order.status_label || order.reason %> | Labor ₱<%= peso(order.labor) %> | <%= Number(order.hours_open || 0).toFixed(1) %>h</div><a href="/work-orders/<%= order.id %>/edit">Details</a></div><% }) %>
    </details>

    <details open><summary>Hours / Activity Trail</summary>
      <% if (!technician.recent_updates.length) { %><p>No activity updates recorded.</p><% } %>
      <% technician.recent_updates.forEach(update => { %><div class="technician-monitor__trail-row"><time><%= new Date(update.created_at || 0).toLocaleString('en-PH') %></time><strong><%= update.status_action ? update.status_action.replace(/_/g, ' ') : 'note' %></strong><span><%= update.message || '' %></span></div><% }) %>
    </details>

    <form method="post" action="/work-order-transactions/technicians/status" class="technician-monitor__status-form">
      <input type="hidden" name="technician_name" value="<%= technician.technician %>">
      <input type="hidden" name="return_to" value="/work-order-transactions/technicians/<%= encodeURIComponent(technician.technician) %>">
      <label>Status<select name="status_action" required>
        <option value="working">Working / In Progress</option>
        <option value="waiting_parts">Waiting for Parts</option>
        <option value="break">On Break</option>
        <option value="on_other_priority">On Other Priority</option>
        <option value="day_off">Day off</option>
        <option value="absent">Absent</option>
      </select></label>
      <label>Related Work Order<select name="work_order_id"><option value="">Present / general</option><% [technician.current_order, ...technician.pending_orders].filter(Boolean).forEach(order => { %><option value="<%= order.id %>">WO <%= order.work_order_number %></option><% }) %></select></label>
      <label>Reason / Note<input name="note" placeholder="Details, blocker or next action"></label>
      <button type="submit" class="btn">Record Activity</button>
    </form>
  </article>
</section>

<%- include('../partials/footer') %>
