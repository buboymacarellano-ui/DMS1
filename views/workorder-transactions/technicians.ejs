<%- include('../partials/header') %>

<section class="dashboard-shell technician-monitor">
  <div class="dashboard-title gm-title">Technician Activity Portal</div>
  <% const techHomeRole = String(currentUser && currentUser.role || '').toLowerCase(); %>
  <% const techHomePath = ['service_advisor', 'service_receptionist', 'senior_service_receptionist'].includes(techHomeRole) ? '/service-receptionist' : '/work-order-transactions'; %>
  <p><a class="btn" href="<%= techHomePath %>"><%= techHomePath === '/service-receptionist' ? 'Back to Dashboard' : 'Back to Work Order Transactions' %></a></p>
  <% if (success) { %><p class="success"><%= success %></p><% } %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <div class="technician-monitor__summary">
    <article><span>Technician Roster</span><strong><%= summary.roster %></strong></article>
    <article><span>Working Now</span><strong><%= summary.working %></strong></article>
    <article><span>Active Work Orders</span><strong><%= summary.activeOrders %></strong></article>
    <article><span>Pending Work Orders</span><strong><%= summary.pendingOrders %></strong></article>
    <article><span>Labor Accumulated</span><strong>₱<%= Number(summary.laborAccumulated || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></article>
    <article><span>Labor MTD</span><strong>₱<%= Number(summary.laborMtd).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></article>
  </div>

  <div class="technician-monitor__toolbar">
    <label>Find Technician <input id="technician-monitor-search" type="search" placeholder="Name, branch or status"></label>
  </div>

  <div class="table-scroll technician-monitor__grid-wrap">
    <table id="technician-monitor-list" class="list technician-monitor__grid">
      <thead>
        <tr><th>#</th><th>Technician</th><th>Branch</th><th>Status</th><th>Present WO</th><th>WO Status</th><th>Vehicle</th><th>Customer</th><th>Active Hours</th><th>Pending</th><th>Labor Acc.</th><th>Labor MTD</th><th>Completed MTD</th><th></th></tr>
      </thead>
      <tbody>
        <% technicians.forEach((technician, index) => { const firstPending = technician.pending_orders[0]; const board = technician.board_status || { label: technician.current_order ? 'On-Going' : 'Idle', tone: technician.current_order ? 'ongoing' : 'idle' }; const present = technician.current_order; %>
          <tr data-technician-row data-search="<%= [technician.technician, technician.branch, technician.job_title, board.label, present && present.work_order_number, present && present.vehicle, present && present.customer, firstPending && firstPending.reason].filter(Boolean).join(' ').toLowerCase() %>">
            <td><%= index + 1 %></td>
            <td><a class="technician-monitor__name-link" href="/work-order-transactions/technicians/<%= encodeURIComponent(technician.technician) %>"><%= technician.technician %></a><small><%= technician.job_title || 'Technician' %></small></td>
            <td><%= technician.branch || '—' %></td>
            <td class="technician-monitor__status-cell technician-monitor__status-cell--<%= board.tone %>"><span class="technician-monitor__status technician-monitor__status--<%= board.tone %>"><%= board.label %></span></td>
            <td><% if (present) { %><a href="/work-orders/<%= present.id %>/edit">WO <%= present.work_order_number %></a><% } else { %>—<% } %></td>
            <td><%= present ? (present.status_label || present.status || '—') : '—' %></td>
            <td><%= present ? (present.vehicle || '—') : '—' %></td>
            <td><%= present ? (present.customer || '—') : '—' %></td>
            <td><%= Number(technician.hours_active || 0).toFixed(1) %>h</td>
            <td title="<%= firstPending ? (firstPending.reason || firstPending.status_label || '') : '' %>"><%= technician.pending_orders.length %></td>
            <td>₱<%= Number(technician.labor_accumulated || 0).toLocaleString('en-PH', { maximumFractionDigits: 2 }) %></td>
            <td>₱<%= Number(technician.labor_mtd || 0).toLocaleString('en-PH', { maximumFractionDigits: 2 }) %></td>
            <td><%= technician.completed_mtd %></td>
            <td><a href="/work-order-transactions/technicians/<%= encodeURIComponent(technician.technician) %>">Details</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<script>
  (function filterTechnicians() {
    const input = document.getElementById('technician-monitor-search');
    const rows = Array.from(document.querySelectorAll('[data-technician-row]'));
    if (!input) return;
    input.addEventListener('input', () => {
      const query = String(input.value || '').trim().toLowerCase();
      rows.forEach(row => { row.hidden = Boolean(query && !String(row.dataset.search || '').includes(query)); });
    });
  })();
</script>

<%- include('../partials/footer') %>