<%- include('../partials/header') %>

<h2>WO Tracker</h2>
<p>Current technician assignments and month-to-date work-order performance.</p>

<div class="wo-view-toggle">
  <span class="wo-view-toggle__label wo-view-toggle__label--active">WO Tracker</span>
  <label class="wo-view-toggle__switch">
    <input type="checkbox" onchange="window.location.href='/work-order-transactions/technicians'">
    <span class="wo-view-toggle__slider"></span>
  </label>
  <span class="wo-view-toggle__label">Technician Assignment</span>
</div>

<% if (currentUser && (currentUser.role === 'general_manager' || currentUser.role === 'admin')) { %>
  <p><a class="btn" href="/kpi/export.csv" style="background:#1f8f53">&#x2B07; Download KPI Report (CSV)</a></p>
  <p><a class="btn" href="/transactions/export.csv" style="background:#0f6d8c">&#x2B07; Download Workorder Transactions (CSV)</a></p>
<% } %>
<% const safeTechStats = (typeof technicianStats !== 'undefined' && technicianStats) ? technicianStats : []; %>

<div class="card" style="margin-top:12px">
  <h3>Technician</h3>
  <p>Current assignments and month-to-date performance.</p>
  <% if (!safeTechStats.length) { %>
    <p>No technician assignments yet.</p>
  <% } else { %>
    <div class="table-scroll">
      <table class="list">
        <thead>
          <tr>
            <th>Technician</th>
            <th>Live Status</th>
            <th>Present WO</th>
            <th>Assigned Car (Current)</th>
            <th>Time Spent (Present Job)</th>
            <th>Total Labor (Accumulated)</th>
            <th>Total Labor Price MTD</th>
            <th>Work Orders Handled MTD</th>
          </tr>
        </thead>
        <tbody>
          <% safeTechStats.forEach(stat => { %>
            <tr>
              <td><%= stat.technician %></td>
              <td><%= stat.live_status || 'Idle' %></td>
              <td>
                <% if (stat.present_wo_id) { %>
                  <a href="/work-orders/<%= stat.present_wo_id %>/edit">WO <%= stat.present_wo %></a>
                <% } else { %>—<% } %>
              </td>
              <td><%= stat.current_car %></td>
              <td><%= stat.current_job_time %></td>
              <td>₱<%= Number(stat.total_labor_accumulated || 0).toFixed(2) %></td>
              <td>₱<%= Number(stat.total_labor_mtd || 0).toFixed(2) %></td>
              <td><%= stat.work_orders_mtd %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
