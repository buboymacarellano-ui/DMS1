<div id="pm-stock-modal" class="pm-modal" hidden aria-hidden="true">
  <div class="pm-modal__backdrop" data-pm-close-modal></div>
  <div class="pm-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pm-stock-modal-title">
    <header class="pm-modal__header">
      <h2 id="pm-stock-modal-title">Adjust Stock Level</h2>
      <button type="button" class="pm-modal__close" data-pm-close-modal aria-label="Close">&times;</button>
    </header>
    <div class="pm-modal__body">
      <p class="pm-modal__meta"><strong id="pm-modal-part-number"></strong> — <span id="pm-modal-part-name"></span></p>
      <p class="dashboard-note admin-note">Current on-hand: <strong id="pm-modal-current-qty">0</strong></p>
      <div class="pm-stepper">
        <button type="button" class="btn pm-stepper__btn" id="pm-stock-minus" aria-label="Decrease quantity">&minus;</button>
        <input type="number" id="pm-stock-delta" value="1" min="1" step="1" />
        <button type="button" class="btn pm-stepper__btn" id="pm-stock-plus" aria-label="Increase quantity">+</button>
      </div>
      <div class="pm-modal__direction">
        <label><input type="radio" name="pm-adjust-direction" value="add" checked /> Add stock (+)</label>
        <label><input type="radio" name="pm-adjust-direction" value="remove" /> Remove stock (&minus;)</label>
      </div>
      <input type="hidden" id="pm-modal-supplier" />
      <p id="pm-modal-error" class="error" hidden></p>
    </div>
    <footer class="pm-modal__footer">
      <button type="button" class="btn" data-pm-close-modal>Cancel</button>
      <button type="button" class="btn pm-btn-primary" id="pm-stock-apply">Apply Adjustment</button>
    </footer>
  </div>
</div>
