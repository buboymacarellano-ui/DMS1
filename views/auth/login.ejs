<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Login Interface</title>
  <% if (typeof skinV2 !== 'undefined' && skinV2) { %>
    <link rel="stylesheet" href="/css/app.css">
  <% } else { %>
    <link rel="stylesheet" href="/styles.css">
  <% } %>
</head>
<body>
  <%- include('../partials/back-button') %>
  <main class="auth-shell">
    <section class="auth-card">
      <div class="auth-brand">
        <p class="brand-text brand-text--auth">
          <span class="brand-text__name">A&amp;E Auto Service</span>
          <span class="brand-text__entity">GROUP INC.</span>
        </p>
        <h1>A&amp;E LogIn</h1>
      </div>
      <p class="auth-subtitle">Sign in with Department, Role, Employee ID, Location / Branch, and password. Employee DB authorizes every role, including GM.</p>

      <% const openAuth = typeof loginAuthDisabled !== 'undefined' && loginAuthDisabled; %>
      <% const deptNow = typeof department !== 'undefined' && department ? department : 'service'; %>
      <% const roleNow = typeof accessLevel !== 'undefined' && accessLevel ? accessLevel : 'service_advisor'; %>
      <% const deptList = (typeof departments !== 'undefined' && Array.isArray(departments)) ? departments : [
        { key: 'service', label: 'Service' },
        { key: 'parts', label: 'Parts' },
        { key: 'stores', label: 'Stores' },
        { key: 'hr', label: 'HR' },
        { key: 'gm', label: 'GM' },
        { key: 'fo', label: 'Finance Office' },
      ]; %>
      <% const rolesByDept = (typeof rolesByDepartment !== 'undefined' && rolesByDepartment) ? rolesByDepartment : {}; %>
      <% const locationsByDept = (typeof locationsByDepartment !== 'undefined' && locationsByDepartment) ? locationsByDepartment : {}; %>
      <% const needsLocation = true; %>
      <% if (openAuth) { %>
        <p class="success">Login auth is disabled, but department, role, employee ID, location, and password still must be filled.</p>
      <% } %>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="success"><%= success %></p>
      <% } %>

      <form method="post" action="/auth/login" class="form auth-form" id="portal-login-form">
        <label>
          Department
          <select name="department" id="login-department" required>
            <% deptList.forEach((dept) => { %>
              <option value="<%= dept.key %>" <%= deptNow === dept.key ? 'selected' : '' %>><%= dept.label %></option>
            <% }) %>
          </select>
        </label>
        <label id="login-role-field">
          Role
          <select name="access_level" id="login-role" required>
            <option value="">-- Select role --</option>
            <% const initialRoles = rolesByDept[deptNow] || []; %>
            <% initialRoles.forEach((roleOpt) => { %>
              <option value="<%= roleOpt.key %>" <%= roleNow === roleOpt.key ? 'selected' : '' %>><%= roleOpt.label %></option>
            <% }) %>
          </select>
        </label>
        <label id="login-id-field">
          <span id="login-id-label">Employee ID</span>
          <input id="login-id-input" type="text" name="username" value="<%= username %>" autocomplete="username" required />
        </label>
        <label id="login-location-field" <%= needsLocation ? '' : 'hidden' %>>
          Location / Branch
          <select name="branch" id="login-location-input" <%= needsLocation ? 'required' : '' %>>
            <option value="">-- Select your assigned location --</option>
            <% const initialLocations = locationsByDept[deptNow] || []; %>
            <% initialLocations.forEach((locationOption) => { %>
              <option value="<%= locationOption %>" <%= branch === locationOption ? 'selected' : '' %>><%= locationOption %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Password
          <input type="password" name="password" autocomplete="current-password" required minlength="6" />
        </label>
        <button type="submit">Log In</button>
      </form>

      <% if (openAuth) { %>
        <p class="auth-hint">Turn login auth back on from <a href="/auth/register-hr">HR Sign Up</a>.</p>
      <% } %>
      <% if (!hasAccounts) { %>
        <p class="auth-hint">No account found yet.</p>
      <% } %>
    </section>
  </main>
  <script>
    (function bindPortalLoginPanel() {
      const form = document.getElementById('portal-login-form');
      const departmentSelect = document.getElementById('login-department');
      const roleField = document.getElementById('login-role-field');
      const roleSelect = document.getElementById('login-role');
      const idField = document.getElementById('login-id-field');
      const idLabel = document.getElementById('login-id-label');
      const idInput = document.getElementById('login-id-input');
      const locationField = document.getElementById('login-location-field');
      const locationInput = document.getElementById('login-location-input');
      if (!form || !departmentSelect || !roleSelect || !idField || !idInput || !locationField || !locationInput) return;

      const fallbackRoles = {
        service: [
          { key: 'service_technical_manager', label: 'STM' },
          { key: 'service_advisor', label: 'SA' },
          { key: 'senior_service_receptionist', label: 'SSR' },
          { key: 'service_receptionist', label: 'SR' },
          { key: 'technician', label: 'Tech' },
        ],
        parts: [
          { key: 'parts_manager', label: 'PM' },
          { key: 'parts_clerk', label: 'Clerk' },
        ],
        stores: [
          { key: 'operations_manager', label: 'OM - Operation Manager' },
          { key: 'store_manager', label: 'SM - Store Manager' },
          { key: 'cashier', label: 'Cashier' },
          { key: 'stores_clerk', label: 'Clerk' },
        ],
        hr: [
          { key: 'hr_manager', label: 'HM - HR Manager' },
          { key: 'hr_generalist', label: 'Generalist' },
          { key: 'payroll', label: 'Payroll' },
          { key: 'hr_clerk', label: 'Clerk' },
        ],
        gm: [
          { key: 'general_manager', label: 'GM' },
        ],
        fo: [
          { key: 'assets_facilities', label: 'Assets & Facilities' },
          { key: 'accounting', label: 'Accounting' },
          { key: 'admin', label: 'Admin' },
        ],
      };
      const serverRoles = <%- JSON.stringify(rolesByDept || {}) %>;
      const rolesByDepartment = Object.assign({}, serverRoles, fallbackRoles);
      const locationsByDepartment = Object.assign({}, <%- JSON.stringify(locationsByDept || {}) %>);
      const selectedRole = <%- JSON.stringify(roleNow) %>;
      const selectedLocation = <%- JSON.stringify(typeof branch !== 'undefined' ? branch : '') %>;

      function rolesFor(department) {
        return (rolesByDepartment[department] || []).slice();
      }

      function fillRoles(department, keepValue) {
        const roles = rolesFor(department);
        const wanted = String(keepValue || '');
        roleSelect.innerHTML = '';
        const blank = document.createElement('option');
        blank.value = '';
        blank.textContent = '-- Select role --';
        roleSelect.appendChild(blank);
        roles.forEach((item) => {
          const option = document.createElement('option');
          option.value = item.key;
          option.textContent = item.label;
          roleSelect.appendChild(option);
        });
        const keys = roles.map((item) => item.key);
        if (wanted && keys.indexOf(wanted) !== -1) {
          roleSelect.value = wanted;
        } else if (roles[0]) {
          roleSelect.value = roles[0].key;
        } else {
          roleSelect.value = '';
        }
      }

      function fillLocations(department, keepValue) {
        const items = locationsByDepartment[department] || locationsByDepartment.service || [];
        const wanted = String(keepValue || '');
        locationInput.innerHTML = '';
        const blank = document.createElement('option');
        blank.value = '';
        blank.textContent = '-- Select your assigned location --';
        locationInput.appendChild(blank);
        items.forEach((name) => {
          const option = document.createElement('option');
          option.value = name;
          option.textContent = name;
          locationInput.appendChild(option);
        });
        locationInput.value = items.indexOf(wanted) !== -1 ? wanted : '';
      }

      function syncLocation(department, keepValue) {
        locationField.hidden = false;
        locationInput.required = true;
        fillLocations(department, keepValue);
      }

      function sync(fromDepartmentChange) {
        const department = String(departmentSelect.value || 'service').toLowerCase();
        const isGm = department === 'gm';
        form.setAttribute('data-department', department);
        roleField.hidden = isGm;
        idField.hidden = false;
        roleSelect.required = !isGm;
        idInput.required = true;
        if (isGm) {
          fillRoles('gm', 'general_manager');
          roleField.hidden = true;
          roleSelect.required = false;
          idField.hidden = false;
          idInput.required = true;
          idLabel.textContent = 'Name';
          idInput.placeholder = 'GM';
          if (fromDepartmentChange || !String(idInput.value || '').trim()) {
            idInput.value = 'GM';
          }
          locationField.hidden = true;
          locationInput.required = false;
          locationInput.value = '';
          return;
        }
        const keepRole = fromDepartmentChange ? '' : (roleSelect.value || selectedRole);
        fillRoles(department, keepRole);
        const keepLocation = fromDepartmentChange ? '' : (locationInput.value || selectedLocation);
        syncLocation(department, keepLocation);
        idLabel.textContent = 'Employee ID';
        idInput.placeholder = 'Enter employee ID from Employee DB';
        if (fromDepartmentChange && String(idInput.value || '').trim().toUpperCase() === 'GM') {
          idInput.value = '';
        }
      }

      departmentSelect.addEventListener('change', function onDepartmentChange() {
        sync(true);
      });
      departmentSelect.addEventListener('input', function onDepartmentInput() {
        sync(true);
      });
      roleSelect.addEventListener('change', function onRoleChange() {
        syncLocation(String(departmentSelect.value || 'service').toLowerCase(), locationInput.value || selectedLocation);
      });
      sync(false);
    })();
  </script>
</body>
</html>
