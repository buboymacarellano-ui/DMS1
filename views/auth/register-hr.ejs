<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Create HR Account</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/back-button') %>
  <main class="auth-shell">
    <section class="auth-card">
      <h1>HR SIGN UP</h1>
      <p class="auth-subtitle">Create a Human Resources account for personnel and staff management.</p>

      <% const openAuth = typeof loginAuthDisabled !== 'undefined' && loginAuthDisabled; %>
      <% if (typeof success !== 'undefined' && success) { %>
        <p class="success"><%= success %></p>
      <% } %>
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="post" action="/auth/login-auth" class="auth-open-form">
        <input type="hidden" name="login_auth_disabled" value="<%= openAuth ? '0' : '1' %>">
        <button type="submit" class="auth-open-toggle<%= openAuth ? ' auth-open-toggle--on' : '' %>">
          <%= openAuth ? 'Enable Login Auth' : 'Disable Login Auth' %>
        </button>
        <p class="auth-hint">
          <% if (openAuth) { %>
            Login auth is OFF. Branch, user ID, and password are not checked. Anyone can log in with an empty form.
          <% } else { %>
            While building, turn this on so login has no branch / user ID / password restrictions. Empty login is accepted.
          <% } %>
        </p>
      </form>

      <form method="post" action="/auth/register-hr" class="form auth-form">
        <label>
          Username
          <input type="text" name="username" value="<%= username %>" autocomplete="username" required />
        </label>
        <label>
          Password
          <input type="password" name="password" autocomplete="new-password" minlength="6" required />
        </label>
        <label>
          Confirm Password
          <input type="password" name="confirm_password" autocomplete="new-password" minlength="6" required />
        </label>
        <button type="submit">Create HR Account</button>
      </form>

      <p class="auth-hint">Back to <a href="/auth/login?level=hr">HR login</a>.</p>
      <p class="auth-hint">Need Admin access? <a href="/auth/register-admin">Create admin account</a>.</p>
      <p class="auth-hint">Need Technician access? <a href="/auth/register-technician">Create Technician account</a>.</p>
      <p class="auth-hint">Need STM access? <a href="/auth/register-stm">Create STM account</a>.</p>
      <p class="auth-hint">Need GM access? <a href="/auth/register-gm">Create GM account</a>.</p>
      <p class="auth-hint">Need an SR account? <a href="/auth/register">Create SR account</a>.</p>
      <p class="auth-hint">Need Parts Manager access? <a href="/auth/register-parts-manager">Create Parts Manager account</a>.</p>
    </section>
  </main>
</body>
</html>
