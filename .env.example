# Copy to .env (or set in Windows environment variables)
# Use a long random string with at least 32 characters in production.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_VALUE_AT_LEAST_32_CHARS
PORT=3000
NODE_ENV=production

# Customer Sales Invoice legal details. Replace with the exact BIR-registered values.
INVOICE_REGISTERED_NAME=A&E AUTO SERVICE GROUP INC.
INVOICE_BUSINESS_NAME=A&E Auto Service Group Inc.
INVOICE_REGISTERED_ADDRESS=REGISTERED BUSINESS ADDRESS
INVOICE_TIN=000-000-000-00000
INVOICE_BRANCH_CODE=00000
INVOICE_PHONE=BUSINESS PHONE
# Set these only when applicable to the registered invoicing method/form.
# INVOICE_ATP_NUMBER=
# INVOICE_PRINTER_ACCREDITATION=

# Optional backup settings
# BACKUP_DIR=C:\\DMS-backup
# BACKUP_RETENTION_DAYS=30
